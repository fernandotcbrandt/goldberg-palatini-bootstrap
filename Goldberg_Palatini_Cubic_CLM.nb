Cell[CellGroupData[{

Cell["9) Cubic Lagrangian and CLM comparison", "Section",ExpressionUUID->"c1071aeb-a4af-4cc4-99c0-36e071bb5910"],

Cell["\<\
Expanding M(eta+kappa phi)^{-1} gives L3 = (kappa/2) M(phi)(G0,G0). \
Corrections to G beyond G0 do not contribute at cubic order because the \
quadratic action is stationary at G0. Thus the cubic action is obtained by \
substituting G0 into kappa lagPhiGG.\
\>", "Text",ExpressionUUID->"8b8c12af-4db7-4683-bb4f-2071198c7c2f"],

Cell["\<\
MakeRule generates the G -> G0 substitutions for all index placements and \
handles the dummy indices. Evaluate supplies the explicit g0Up expression to \
MakeRule. The result lag3 contains only phi and its first background \
derivatives.\
\>", "Text",ExpressionUUID->"c062f0cd-41f5-4679-81e9-c7cafcfd0328"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g0Rules", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GG", "[", 
         RowBox[{"a", ",", "b", ",", "c"}], "]"}], ",", "g0Up"}], "}"}], 
      "]"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998395479731291*^9, 3.99839548097279*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"086885bb-a5a2-49aa-b3bc-e41e39da22e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lag3", "=", 
   RowBox[{
    RowBox[{"ToCanonical", "[", 
     RowBox[{"ContractMetric", "[", 
      RowBox[{"Expand", "[", 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"(", 
         RowBox[{"lagPhiGG", "/.", " ", "g0Rules"}], ")"}]}], "]"}], "]"}], 
     "]"}], "//", "Simplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9983954973524523`*^9, 3.998395498470841*^9}, {
  3.998395549906891*^9, 3.998395556280575*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"d5e611cf-9be2-442f-a93c-0ef8a58b1564"],

