Cell["\<\
Contracting the imported kernels with fields gives lagGG = eta^{ab} Q_ab and \
lagPhiGG = phi^{ab} Q_ab, where Q_ab = -G^c_ae G^e_bc + G^c_ac G^e_be/(d-1). \
The first-order Lagrangian is -G partial(phi) + lagGG + kappa lagPhiGG. The \
displayed two-component residual checks both contractions and their \
normalization; the expected result is {0,0}.\
\>", "Text",ExpressionUUID->"43601891-97cc-451c-919f-c558f8f9dcb1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lagGG", "=", 
    RowBox[{"ToCanonical", "[", 
     RowBox[{"ContractMetric", "[", 
      RowBox[{"kGG", " ", 
       RowBox[{"GG", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}]}], "]"}], " ", 
       RowBox[{"GG", "[", 
        RowBox[{
         RowBox[{"-", "e"}], ",", 
         RowBox[{"-", "f"}], ",", 
         RowBox[{"-", "g"}]}], "]"}]}], "]"}], "]"}]}], ";"}], " "}]], "Input",\

 CellChangeTimes->{{3.9983939952793407`*^9, 3.9983939974599543`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"553d646a-cc5f-4d7a-a78f-3070689be21f"],

