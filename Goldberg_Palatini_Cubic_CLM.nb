Cell["\<\
quadraticBoundaryCurrent represents J^a = [phi^{bc} CD_c phi^a_b - phi^{ab} \
CD_c phi^c_b]/2. The next residual verifies L2 + L_(2)^CLM/2 = CD_a J^a. \
Equality of the integrated actions assumes compact support or boundary \
conditions that remove the integral of this divergence.\
\>", "Text",ExpressionUUID->"4e4c86bf-69d4-4e52-b0e9-0e5e47657f72"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"quadraticBoundaryCurrent", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"phi", "[", 
        RowBox[{"b", ",", "c"}], "]"}], " ", 
       RowBox[{
        RowBox[{"CD", "[", 
         RowBox[{"-", "c"}], "]"}], "[", 
        RowBox[{"phi", "[", 
         RowBox[{"a", ",", 
          RowBox[{"-", "b"}]}], "]"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"phi", "[", 
        RowBox[{"a", ",", "b"}], "]"}], " ", 
       RowBox[{
        RowBox[{"CD", "[", 
         RowBox[{"-", "c"}], "]"}], "[", 
        RowBox[{"phi", "[", 
         RowBox[{"c", ",", 
          RowBox[{"-", "b"}]}], "]"}], "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"quadraticBoundaryCheck", "=", 
  RowBox[{
   RowBox[{"ToCanonical", "[", 
    RowBox[{"ContractMetric", "[", 
     RowBox[{"Expand", "[", 
      RowBox[{"clmQuadraticDifference", "-", 
       RowBox[{
        RowBox[{"CD", "[", 
         RowBox[{"-", "a"}], "]"}], "[", "quadraticBoundaryCurrent", "]"}]}], 
      "]"}], "]"}], "]"}], "//", "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.998396527393134*^9, 3.998396548523588*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"13b929c6-4050-4c47-ac3b-0e5c1e267446"],

