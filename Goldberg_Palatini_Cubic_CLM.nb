Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"Dimension\"\>", "\[Rule]", "GPBootstrapData`Dimension"}], ",", 
    RowBox[{"\<\"Normalization\"\>", 
     "\[Rule]", "\<\"cGG = 1/(Nd-1); action Eq. (5.1); kernels have no extra \
factorials; restore kappa multiplying phi G G.\"\>"}], ",", 
    RowBox[{"\<\"GGSlots\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\<\"lambda\"\>", ",", "\<\"mu\"\>", ",", "\<\"nu\"\>", 
       ",", "\<\"rho\"\>", ",", "\<\"sigma\"\>", ",", "\<\"tau\"\>"}], 
      "}"}]}], ",", 
    RowBox[{"\<\"PhiGGSlots\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\<\"mu\"\>", ",", "\<\"nu\"\>", ",", "\<\"lambda\"\>", 
       ",", "\<\"alpha\"\>", ",", "\<\"beta\"\>", ",", "\<\"rho\"\>", 
       ",", "\<\"sigma\"\>", ",", "\<\"tau\"\>"}], "}"}]}], ",", 
    RowBox[{"\<\"Representation\"\>", 
     "\[Rule]", "\<\"Eta[i,j] is the abstract flat metric between free slots \
i,j, not a component with numerical indices. All kernel indices are raised in \
the FeynCalc representation. Integer slots are labels, not summed \
indices.\"\>"}], ",", 
    RowBox[{"\<\"InverseStatus\"\>", 
     "\[Rule]", "\<\"Not exported. Construct or import M0Inverse in the xAct \
notebook and verify its product with this M0 on symmetric connection tensors.\
\"\>"}]}], "\[RightAssociation]"}], TraditionalForm]], "Output",
