Cell[BoxData[
 RowBox[{
  RowBox[{"connectionIdentity", "=", 
   RowBox[{
    RowBox[{"eta", "[", 
     RowBox[{"a", ",", "e"}], "]"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"eta", "[", 
         RowBox[{"b", ",", "f"}], "]"}], " ", 
        RowBox[{"eta", "[", 
         RowBox[{"c", ",", "g"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"eta", "[", 
         RowBox[{"b", ",", "g"}], "]"}], " ", 
        RowBox[{"eta", "[", 
         RowBox[{"c", ",", "f"}], "]"}]}]}], ")"}], "/", "2"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9983945096070213`*^9, 3.998394523591145*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"c1b0ac77-32fe-4908-aa95-dbbedfc0dc17"],

Cell[BoxData[
 RowBox[{
  RowBox[{"inverseResidual", "=", 
   RowBox[{"ToCanonical", "[", 
    RowBox[{"ContractMetric", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m0", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"e", "->", 
            RowBox[{"-", "h"}]}], ",", 
           RowBox[{"f", "->", 
            RowBox[{"-", "i"}]}], ",", 
           RowBox[{"g", "->", 
            RowBox[{"-", "j"}]}]}], "}"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"inverseAnsatz", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a", "->", "h"}], ",", 
           RowBox[{"b", "->", "i"}], ",", 
           RowBox[{"c", "->", "j"}]}], "}"}]}], ")"}]}], "-", 
      "connectionIdentity"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9983945261385*^9, 3.9983945458643208`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"5ef31fca-b416-4a29-b14c-eda3a3a8573f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"inverseSolution", "=", 
