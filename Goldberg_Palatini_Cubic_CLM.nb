Cell["\<\
clmCubicResidual verifies the exact local identity lag3 + (kappa/2) lag3CLM = \
0. Unlike the quadratic comparison, no integration by parts is needed, and no \
equations of motion for phi are used. The check concerns the transcribed CLM \
Eq. (2.16). Equality of the corresponding vertices follows with consistent \
Fourier and symmetrization conventions, but Eq. (2.17) is not independently \
transcribed or tested here.\
\>", "Text",ExpressionUUID->"32a74560-b274-4ead-9e8a-6827ec36d617"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"clmCubicResidual", "=", 
  RowBox[{
   RowBox[{"ToCanonical", "[", 
    RowBox[{"ContractMetric", "[", 
     RowBox[{"Expand", "[", 
      RowBox[{"lag3", "+", 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"lag3CLM", "/", "2"}]}]}], "]"}], "]"}], "]"}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.9983967128057003`*^9, 3.9983967150778217`*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"a4896ad4-88f6-4077-be02-9eccc79fa39d"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{3.998396715591867*^9, 3.998396818444076*^9, 
  3.998396932805304*^9, 3.9983982322279463`*^9, 3.998399028924931*^9, 
  4.000984529017543*^9},
 CellLabel->"Out[64]=",ExpressionUUID->"0222e5c2-b1fb-4cdc-91f4-114c9fd69334"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10) Final comparison checks", "Section",ExpressionUUID->"e866c636-2a8a-4cf6-bebf-91422b2b1ab1"],

Cell["\<\
The summary records the two-sided inverse test, the defining equation for G0, \
the quadratic variational and explicit boundary checks, and the direct cubic \
comparison. Each residual must be exactly zero. The final PASS message tests \
these values; it does not assert a separate momentum-space vertex calculation.\
\>", "Text",ExpressionUUID->"8024a34b-57f2-44ee-a034-879a67363665"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"comparisonChecks", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<M0 inverse: both orders\>\"", "->", "inverseChecks"}], ",", 
      RowBox[{"\"\<Linear connection equation\>\"", "->", "g0Check"}], ",", 
      RowBox[{"\"\<Quadratic: Euler derivative\>\"", "->", 
       "clmQuadraticCheck"}], ",", 
      RowBox[{"\"\<Quadratic: explicit boundary term\>\"", "->", 
       "quadraticBoundaryCheck"}], ",", 
      RowBox[{"\"\<Cubic: direct equality with CLM normalization\>\"", "->", 
       "clmCubicResidual"}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", "comparisonChecks"}], "Input",
 CellChangeTimes->{{3.9983966291943913`*^9, 3.9983966302886677`*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"7e128a56-600a-4fb5-8425-7aa9fbcb6130"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"M0 inverse: both orders\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ",", 
    RowBox[{"\<\"Linear connection equation\"\>", "\[Rule]", "0"}], ",", 
    RowBox[{"\<\"Quadratic: Euler derivative\"\>", "\[Rule]", "0"}], ",", 
    RowBox[{"\<\"Quadratic: explicit boundary term\"\>", "\[Rule]", "0"}], ",", 
    RowBox[{"\<\"Cubic: direct equality with CLM normalization\"\>", "\[Rule]",
      "0"}]}], "\[RightAssociation]"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.998396631636982*^9, 3.998396717631537*^9, 
  3.9983968184481173`*^9, 3.9983969328279467`*^9, 3.998398232231958*^9, 
  3.998399028928838*^9, 4.000984529044385*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"7a0a3c8c-d0db-4d30-baf0-a8de7f8b73b4"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"SameQ", "[", 
        RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Values", "[", "comparisonChecks", "]"}], "]"}]}], ")"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.998396886123241*^9, 3.9983968872058897`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"a88ac028-01a6-40d7-8a53-4e187aadb3c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"allChecksPassed", ",", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<PASS: the quadratic and cubic Lagrangians agree with CLM, \
\>\"", ",", "\"\<after accounting for the overall normalization and the \>\"",
       ",", "\"\<explicit quadratic total derivative.\>\""}], "]"}], ",", 
    RowBox[{"Print", "[", "\"\<FAIL: inspect comparisonChecks.\>\"", "]"}]}], 
   "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.99839688901821*^9, 3.998396900690632*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"e53abcea-d2d3-46b4-a1b9-fc3b582d1269"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"PASS: the quadratic and cubic Lagrangians agree with CLM, \
\"\>", "\[InvisibleSpace]", "\<\"after accounting for the overall \
normalization and the \"\>", 
    "\[InvisibleSpace]", "\<\"explicit quadratic total derivative.\"\>"}],
   SequenceForm[
   "PASS: the quadratic and cubic Lagrangians agree with CLM, ", 
    "after accounting for the overall normalization and the ", 
    "explicit quadratic total derivative."],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{3.998396901950398*^9, 3.99839693283821*^9, 
  3.998398232247634*^9, 3.998399028950053*^9, 4.000984529097587*^9},
