 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{"$Packages", ",", "\"\<FeynCalc`\>\""}], "]"}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Assign this notebook a fresh kernel without FeynCalc, \
then evaluate again.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"Needs", "[", "\"\<xAct`xTras`\>\"", "]"}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"25af4289-1ec7-4d08-baf3-84031daf5c24"],

