Cell["\<\
For this basis order the solution is (0,0,-1/[2(d-2)],1/2,-1). The inverse is \
derived from the exported M0. Both multiplication orders are checked \
explicitly, with expected result {0,0}; no projection onto a particular field \
configuration is used.\
\>", "Text",ExpressionUUID->"2ac47de6-13b1-485a-85d6-7a6cc3841235"],

Cell[BoxData[
 RowBox[{
  RowBox[{"m0Inverse", "=", 
   RowBox[{"ToCanonical", "[", 
    RowBox[{"inverseAnsatz", "/.", " ", 
     RowBox[{"First", "[", "inverseSolution", "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.998394659618127*^9, 3.998394660817361*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"0b8a1982-eeaf-463d-801e-93ce688f9840"],

