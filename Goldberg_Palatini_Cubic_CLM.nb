Cell[BoxData[{
 RowBox[{
  RowBox[{"lagGonshell", "=", 
   RowBox[{
    RowBox[{"ContractMetric", "[", 
     RowBox[{"ToCanonical", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"g", "[", 
          RowBox[{"\[Lambda]", ",", 
           RowBox[{"-", "\[Mu]"}], ",", 
           RowBox[{"-", "\[Nu]"}]}], "]"}]}], 
        RowBox[{
         RowBox[{"PD", "[", 
          RowBox[{"-", "\[Lambda]"}], "]"}], "[", 
         RowBox[{"h", "[", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"h", "[", 
         RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"d", "-", "1"}], ")"}]}], " ", 
           RowBox[{"g", "[", 
            RowBox[{"\[Lambda]", ",", 
             RowBox[{"-", "\[Lambda]"}], ",", 
             RowBox[{"-", "\[Mu]"}]}], "]"}], 
           RowBox[{"g", "[", 
            RowBox[{"\[Sigma]", ",", 
             RowBox[{"-", "\[Nu]"}], ",", 
             RowBox[{"-", "\[Sigma]"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{"\[Lambda]", ",", 
             RowBox[{"-", "\[Mu]"}], ",", 
             RowBox[{"-", "\[Sigma]"}]}], "]"}], 
           RowBox[{"g", "[", 
            RowBox[{"\[Sigma]", ",", 
             RowBox[{"-", "\[Nu]"}], ",", 
             RowBox[{"-", "\[Lambda]"}]}], "]"}]}]}], ")"}]}]}], "]"}], "]"}],
     "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagGonshell", " ", "//", "ScreenDollarIndices"}], "//", 
  "StandardForm"}]}], "Input",
