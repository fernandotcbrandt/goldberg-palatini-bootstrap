   3.998396930187614*^9, 3.9983982295789967`*^9, 3.998399026239193*^9, 
   4.0009845234047403`*^9, 4.00116800083183*^9, 4.0011682218807497`*^9, 
   4.001168308783381*^9, 4.001169344238702*^9, 4.001170706426738*^9, 
   4.001180026758453*^9, 4.001180878033758*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"0bc24f73-db72-4247-b4b7-9d5bf4038b77"]
}, Open  ]],

Cell["\<\
prettyKernel provides a display of the imported slot polynomials. It does not \
define xAct tensors. Formatting wrappers such as StandardForm and \
TraditionalForm are used for display; the algebra below uses unformatted \
expressions.\
\>", "Text",ExpressionUUID->"14c2b4cb-bb50-44aa-8537-287d0302698e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"prettyKernel", "[", 
    RowBox[{"expr_", ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"TraditionalForm", "[", 
    RowBox[{"expr", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GPBootstrapData`Dimension", "->", "d"}], ",", 
       RowBox[{
        RowBox[{"GPBootstrapData`Eta", "[", 
         RowBox[{"i_Integer", ",", "j_Integer"}], "]"}], ":>", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<\[Eta]\>\"", ",", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"labels", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"labels", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}]}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998388439678747*^9, 3.998388441301729*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"ce37aa40-572a-4e09-9b4d-465c068e6187"],

