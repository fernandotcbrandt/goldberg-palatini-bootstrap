    RowBox[{"toXActKernel", "[", 
     RowBox[{"kGGData", ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c", ",", "e", ",", "f", ",", "g"}], 
       "}"}]}], "]"}], " ", "//", " ", "ToCanonical"}]}], " ", ";"}]], "Input",\

