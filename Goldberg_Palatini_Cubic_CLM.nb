            RowBox[{
             RowBox[{"CD", "[", "c", "]"}], "[", 
             RowBox[{"phi", "[", 
              RowBox[{"e", ",", 
               RowBox[{"-", "e"}]}], "]"}], "]"}], "/", 
            RowBox[{"(", 
