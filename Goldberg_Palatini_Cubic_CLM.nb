 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{"$Packages", ",", "\"\<FeynCalc`\>\""}], "]"}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", 
      "\"\<Assign this notebook a fresh kernel without FeynCalc, then \
evaluate again.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"Needs", "[", "\"\<xAct`xTras`\>\"", "]"}], ";"}]], "Input",
