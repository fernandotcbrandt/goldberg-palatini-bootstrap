     RowBox[{
      RowBox[{"VarD", "[", 
       RowBox[{
        RowBox[{"phi", "[", 
         RowBox[{"a", ",", "b"}], "]"}], ",", "CD"}], "]"}], "[", 
      "clmQuadraticDifference", "]"}], "]"}], "]"}], "//", 
   "Simplify"}]}]], "Input",
