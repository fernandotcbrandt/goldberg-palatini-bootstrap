             RowBox[{
              RowBox[{"-", "b"}], ",", "e"}], "]"}], "]"}]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"CD", "[", 
             RowBox[{"-", "c"}], "]"}], "[", 
            RowBox[{"phi", "[", 
             RowBox[{
              RowBox[{"-", "a"}], ",", 
              RowBox[{"-", "b"}]}], "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", "c", "]"}], "[", 
             RowBox[{"phi", "[", 
              RowBox[{"e", ",", 
               RowBox[{"-", "e"}]}], "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"d", "-", "2"}], ")"}]}]}]}], ")"}]}], "]"}], "]"}], "//",
