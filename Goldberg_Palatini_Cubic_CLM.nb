            RowBox[{"phi", "[", 
             RowBox[{
              RowBox[{"-", "b"}], ",", "e"}], "]"}], "]"}]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"CD", "[", 
             RowBox[{"-", "c"}], "]"}], "[", 
            RowBox[{"phi", "[", 
             RowBox[{
              RowBox[{"-", "a"}], ",", 
              RowBox[{"-", "b"}]}], "]"}], "]"}], " ", 
