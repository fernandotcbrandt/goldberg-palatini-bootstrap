Cell[CellGroupData[{

Cell["6) Derivation of the inverse of M0", "Section",ExpressionUUID->"1d9d23b1-b4e5-4cad-9fae-e1fa5afd97e6"],

Cell["\<\
metricPairings generates the 15 products of three metrics joining six free \
slots. Averaging over the two symmetric lower-index pairs and exchange of the \
connection blocks gives five distinct basis elements. The ansatz is \
parity-even and algebraic in the background metric. A symmetric inverse, when \
it exists, has these same block symmetries.\
\>", "Text",ExpressionUUID->"78c6ca6c-211c-4c01-bea3-0f1c43496b42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"metricPairings", ",", "symInverse"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"metricPairings", "[", 
    RowBox[{"{", "}"}], "]"}], ":=", 
   RowBox[{"{", "1", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"metricPairings", "[", "indices_List", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"eta", "[", 
        RowBox[{
         RowBox[{"First", "[", "indices", "]"}], ",", 
         RowBox[{"indices", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
       RowBox[{"metricPairings", "[", 
        RowBox[{"Delete", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "indices", "]"}], ",", 
          RowBox[{"j", "-", "1"}]}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2", ",", 
        RowBox[{"Length", "[", "indices", "]"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"symInverse", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"res", "=", "expr"}], "}"}], ",", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"res", "+", 
          RowBox[{"(", 
           RowBox[{"res", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"b", "->", "c"}], ",", 
              RowBox[{"c", "->", "b"}]}], "}"}]}], ")"}]}], ")"}], "/", 
        "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"res", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"res", "+", 
          RowBox[{"(", 
           RowBox[{"res", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"f", "->", "g"}], ",", 
              RowBox[{"g", "->", "f"}]}], "}"}]}], ")"}]}], ")"}], "/", 
        "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"res", "=", 
       RowBox[{
        RowBox[{"(", 
