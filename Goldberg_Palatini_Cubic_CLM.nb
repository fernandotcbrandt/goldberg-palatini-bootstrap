Cell["\<\
This cell substitutes the constructed G0 into its defining linear equation M0 \
G0 = partial(phi). The three connection slots are contracted, leaving (a,b,c) \
free, and CD[a][phi[b,c]] is subtracted. The expected residual is zero. It \
checks the index placement and normalization of the inverse application; it \
is a consistency check, not an independent derivation.\
\>", "Text",ExpressionUUID->"7af1e68f-d0e8-4c85-830b-a743f5872ad6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g0Check", "=", 
   RowBox[{
    RowBox[{"ToCanonical", "[", 
     RowBox[{"ContractMetric", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"m0", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"e", "->", 
             RowBox[{"-", "h"}]}], ",", 
            RowBox[{"f", "->", 
             RowBox[{"-", "i"}]}], ",", 
            RowBox[{"g", "->", 
             RowBox[{"-", "j"}]}]}], "}"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"g0Up", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "->", "h"}], ",", 
            RowBox[{"b", "->", "i"}], ",", 
            RowBox[{"c", "->", "j"}]}], "}"}]}], ")"}]}], "-", 
       RowBox[{
        RowBox[{"CD", "[", "a", "]"}], "[", 
        RowBox[{"phi", "[", 
         RowBox[{"b", ",", "c"}], "]"}], "]"}]}], "]"}], "]"}], "//", 
    "Simplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99839509282917*^9, 3.998395094029208*^9}, {
  3.9983954057966633`*^9, 3.998395408854393*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"a72c799e-07f7-4add-93fe-bb53d48518ab"],

