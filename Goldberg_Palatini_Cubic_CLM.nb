     RowBox[{"ContractMetric", "[", 
      RowBox[{"Expand", "[", 
       RowBox[{"lag2", "+", 
        RowBox[{"lag2CLM", "/", "2"}]}], "]"}], "]"}], "]"}], "//", 
    "Simplify"}]}], ";"}]], "Input",
