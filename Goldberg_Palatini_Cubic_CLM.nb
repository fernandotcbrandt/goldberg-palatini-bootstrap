Cell[BoxData[
 RowBox[{
  RowBox[{"inverseResidual", "=", 
   RowBox[{"ToCanonical", "[", 
    RowBox[{"ContractMetric", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m0", "/.", " ", 
         RowBox[{"{", 
