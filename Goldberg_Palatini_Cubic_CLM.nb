   RowBox[{"{", "1", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"metricPairings", "[", "indices_List", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"eta", "[", 
        RowBox[{
         RowBox[{"First", "[", "indices", "]"}], ",", 
         RowBox[{"indices", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
       RowBox[{"metricPairings", "[", 
        RowBox[{"Delete", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "indices", "]"}], ",", 
          RowBox[{"j", "-", "1"}]}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2", ",", 
        RowBox[{"Length", "[", "indices", "]"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"symInverse", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"res", "=", "expr"}], "}"}], ",", 
     RowBox[{
      RowBox[{"res", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"res", "+", 
          RowBox[{"(", 
           RowBox[{"res", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"b", "->", "c"}], ",", 
              RowBox[{"c", "->", "b"}]}], "}"}]}], ")"}]}], ")"}], "/", 
        "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"res", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"res", "+", 
          RowBox[{"(", 
           RowBox[{"res", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"f", "->", "g"}], ",", 
              RowBox[{"g", "->", "f"}]}], "}"}]}], ")"}]}], ")"}], "/", 
        "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"res", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"res", "+", 
          RowBox[{"(", 
           RowBox[{"res", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "->", "e"}], ",", 
              RowBox[{"b", "->", "f"}], ",", 
              RowBox[{"c", "->", "g"}], ",", 
              RowBox[{"e", "->", "a"}], ",", 
              RowBox[{"f", "->", "b"}], ",", 
              RowBox[{"g", "->", "c"}]}], "}"}]}], ")"}]}], ")"}], "/", 
        "2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ToCanonical", "[", 
       RowBox[{"Expand", "[", "res", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"inverseBasis", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"symInverse", "/@", 
     RowBox[{"metricPairings", "[", 
      RowBox[{"{", 
