Cell[CellGroupData[{

Cell["2) Symbols", "Section",ExpressionUUID->"28fb6e71-fded-47e5-9d16-39b1b28a4d86"],

Cell["\<\
d is the symbolic spacetime dimension and kappa (the Greek symbol in the \
code) is the gravitational coupling. The exported first-order kernels have \
the coupling stripped off; lag3 restores one power of kappa.\
\>", "Text",ExpressionUUID->"a98d9cdd-3105-4991-937f-96fb658a4faf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", "d", "]"}], ";", 
  RowBox[{"DefConstantSymbol", "[", "\[Kappa]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.998395586987433*^9, 3.998395591497241*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"07b5dcf5-0263-45af-a943-ca885dde24a0"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"** \"\>", "\[InvisibleSpace]", "DefConstantSymbol", 
    "\[InvisibleSpace]", "\<\": Defining \"\>", 
    "\[InvisibleSpace]", "\<\"constant symbol \"\>", "\[InvisibleSpace]", "d",
     "\[InvisibleSpace]", "\<\". \"\>", "\[InvisibleSpace]", "\<\"\"\>"}],
   SequenceForm[
   "** ", xAct`xTensor`DefConstantSymbol, ": Defining ", 
    "constant symbol ", $CellContext`d, ". ", ""],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{4.001168308628643*^9, 4.001169344043103*^9, 
  4.001170706240152*^9, 4.0011800267050047`*^9, 4.001180877994349*^9, 
  4.00118253951346*^9},
