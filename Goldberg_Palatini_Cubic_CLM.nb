        RowBox[{"phi", "[", 
         RowBox[{
          RowBox[{"-", "f"}], ",", 
          RowBox[{"-", "g"}]}], "]"}], "]"}]}], "]"}], "]"}], "//", 
    "Simplify"}]}], ";"}]], "Input",
