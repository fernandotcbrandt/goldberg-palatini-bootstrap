Cell["\<\
toXActKernel replaces the neutral dimension and metric slots by d and eta \
with the specified abstract indices. The variables kGG, kPhiGG, m0 and \
mPhiCoefficient retain all free indices raised. mPhiCoefficient still has two \
phi slots; it becomes M(phi) after contraction with phi in those slots.\
\>", "Text",ExpressionUUID->"4c81253c-4df1-45de-afb5-b1d64f57deaf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"toXActKernel", "[", 
    RowBox[{"expr_", ",", "slots_List"}], "]"}], ":=", 
   RowBox[{"expr", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"GPBootstrapData`Dimension", "->", "d"}], ",", 
      RowBox[{
       RowBox[{"GPBootstrapData`Eta", "[", 
        RowBox[{"i_Integer", ",", "j_Integer"}], "]"}], ":>", 
       RowBox[{"eta", "[", 
        RowBox[{
         RowBox[{"slots", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"slots", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.998393167802894*^9, 3.9983931691051197`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"9ba5daff-1053-42a9-94da-ea52b8bc9df0"],

