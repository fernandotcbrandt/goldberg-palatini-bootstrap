     RowBox[{"phi", "[", 
      RowBox[{"a", ",", "b"}], "]"}], ",", "Spacetime", ",", 
     RowBox[{"Symmetric", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "]"}], ",", 
     RowBox[{"PrintAs", "->", "\"\<\[Phi]\>\""}]}], "]"}], ";"}], 
