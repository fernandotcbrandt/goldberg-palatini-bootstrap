        RowBox[{"1", "/", "2"}], " ", 
        RowBox[{"phi", "[", 
         RowBox[{"a", ",", "b"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
