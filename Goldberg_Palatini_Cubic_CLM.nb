     "\"\<\[Alpha]\>\"", ",", "\"\<\[Beta]\>\"", ",", "\"\<\[Rho]\>\"", ",", 
     "\"\<\[Sigma]\>\"", ",", "\"\<\[Tau]\>\""}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9983884867178707`*^9, 3.998388487838832*^9}},
