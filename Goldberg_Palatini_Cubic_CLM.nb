             RowBox[{"-", "a"}], "]"}], "[", 
            RowBox[{"phi", "[", 
             RowBox[{"c", ",", "e"}], "]"}], "]"}], " ", 
           RowBox[{
            RowBox[{"CD", "[", 
             RowBox[{"-", "b"}], "]"}], "[", 
            RowBox[{"phi", "[", 
             RowBox[{
              RowBox[{"-", "c"}], ",", 
              RowBox[{"-", "e"}]}], "]"}], "]"}]}], "-", 
          RowBox[{
