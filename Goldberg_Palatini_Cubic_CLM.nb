Cell[CellGroupData[{

Cell["3) Load the bootstrap kernels", "Section",ExpressionUUID->"68c2d203-2803-4790-9948-d60aa021aae5"],

Cell["\<\
The import contains the normalized KGG and KPhiGG kernels, M0 = 2 KGG, and \
the coefficient of phi in M(phi) = 2 KPhiGG. GPBootstrapData`Eta[i,j] denotes \
a metric between free index slots, not numerical components. The six-slot \
order is (lambda,mu,nu,rho,sigma,tau); the eight-slot order is \
(mu,nu,lambda,alpha,beta,rho,sigma,tau). All exported kernel indices are \
raised. The package-independent representation is converted to xAct below.\
\>", "Text",ExpressionUUID->"8ef366e1-430f-4e9d-b007-cc44599994ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kernelFile", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<Goldberg_Palatini_Bootstrap_kernels.wl\>\""}], "}"}], "]"}]}],
   ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"FileExistsQ", "[", "kernelFile", "]"}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Kernel file not found. Evaluate the bootstrap export \
cell and keep the resulting .wl file beside this notebook.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"bootstrapData", "=", 
   RowBox[{"Get", "[", "kernelFile", "]"}]}], ";"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"0d456665-1129-45cc-b67c-c281574487be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"requiredKeys", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<SchemaVersion\>\"", ",", "\"\<Dimension\>\"", 
     ",", "\"\<KGG\>\"", ",", "\"\<KPhiGG\>\"", ",", "\"\<M0\>\"", 
     ",", "\"\<MPhiCoefficient\>\"", ",", "\"\<GGSlots\>\"", 
     ",", "\"\<PhiGGSlots\>\""}], "}"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"!", 
      RowBox[{"AssociationQ", "[", "bootstrapData", "]"}]}], "||", 
     RowBox[{"!", 
      RowBox[{"And", "@@", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"bootstrapData", ",", "#1"}], "]"}], "&"}], ")"}], "/@", 
        "requiredKeys"}]}]}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Invalid or incomplete bootstrap export.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"bootstrapData", "[", "\"\<SchemaVersion\>\"", "]"}], "=!=", 
     "1"}], ",", 
    RowBox[{
