Cell[CellGroupData[{

Cell["3) Load the bootstrap kernels", "Section",ExpressionUUID->"68c2d203-2803-4790-9948-d60aa021aae5"],

Cell["\<\
The import contains the normalized KGG and KPhiGG kernels, M0 = 2 KGG, and \
the coefficient of phi in M(phi) = 2 KPhiGG. GPBootstrapData`Eta[i,j] denotes \
a metric between free index slots, not numerical components. The six-slot \
order is (lambda,mu,nu,rho,sigma,tau); the eight-slot order is \
(mu,nu,lambda,alpha,beta,rho,sigma,tau). All exported kernel indices are \
raised. The package-independent representation is converted to xAct below.\
\>", "Text",ExpressionUUID->"8ef366e1-430f-4e9d-b007-cc44599994ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kernelFile", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<Goldberg_Palatini_Bootstrap_kernels.wl\>\""}], "}"}], "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"FileExistsQ", "[", "kernelFile", "]"}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", 
      "\"\<Kernel file not found. Evaluate the bootstrap export cell and keep \
the resulting .wl file beside this notebook.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"bootstrapData", "=", 
   RowBox[{"Get", "[", "kernelFile", "]"}]}], ";"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"0d456665-1129-45cc-b67c-c281574487be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"requiredKeys", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<SchemaVersion\>\"", ",", "\"\<Dimension\>\"", ",", "\"\<KGG\>\"", 
     ",", "\"\<KPhiGG\>\"", ",", "\"\<M0\>\"", ",", "\"\<MPhiCoefficient\>\"",
      ",", "\"\<GGSlots\>\"", ",", "\"\<PhiGGSlots\>\""}], "}"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"!", 
      RowBox[{"AssociationQ", "[", "bootstrapData", "]"}]}], "||", 
     RowBox[{"!", 
      RowBox[{"And", "@@", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"bootstrapData", ",", "#1"}], "]"}], "&"}], ")"}], "/@", 
        "requiredKeys"}]}]}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Invalid or incomplete bootstrap export.\>\"", "]"}], 
     ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"bootstrapData", "[", "\"\<SchemaVersion\>\"", "]"}], "=!=", 
     "1"}], ",", 
    RowBox[{
     RowBox[{"Print", "[", "\"\<Unsupported export schema.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{"bootstrapData", ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<KGG\>\"", ",", "\"\<KPhiGG\>\"", ",", "\"\<M0\>\"", ",", 
           "\"\<MPhiCoefficient\>\""}], "}"}]}], "]"}], ",", 
       RowBox[{"s_Symbol", "/;", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<System`\>\"", ",", "\"\<GPBootstrapData`\>\""}], 
            "}"}], ",", 
           RowBox[{"Context", "[", "s", "]"}]}], "]"}]}]}]}], "]"}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", 
      "\"\<The export contains unevaluated or package-dependent objects. \
Reevaluate the corrected bootstrap export cell before continuing.\>\"", "]"}],
      ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Bootstrap kernels loaded: \>\"", ",", 
    RowBox[{"FileNameTake", "[", "kernelFile", "]"}]}], "]"}], ";"}]], "Input",\

 CellLabel->"In[4]:=",ExpressionUUID->"b82a5a99-4eca-444e-87e9-9ed2c7b58165"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"Bootstrap kernels loaded: \"\>", 
    "\[InvisibleSpace]", "\<\"Goldberg_Palatini_Bootstrap_kernels.wl\"\>"}],
   SequenceForm[
   "Bootstrap kernels loaded: ", "Goldberg_Palatini_Bootstrap_kernels.wl"],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{
  3.9983881525791616`*^9, 3.998388663142715*^9, 3.9983888661727867`*^9, 
   3.998389279498019*^9, 3.9983929453265133`*^9, 3.9983934819655743`*^9, 
   3.99839363508884*^9, 3.9983938626286097`*^9, 3.998394076185993*^9, 
   3.9983943821522703`*^9, 3.998394585135235*^9, 3.998394818448844*^9, 
   3.9983950217767677`*^9, {3.998395398495151*^9, 3.998395425158752*^9}, 
   3.9983957114807796`*^9, 3.998395808525069*^9, 3.998396021060164*^9, 
   3.998396438098178*^9, 3.998396586385256*^9, 3.9983968151821547`*^9, 
   3.998396930161848*^9, 3.998398229559807*^9, 3.998399026211486*^9},
 CellLabel->
  "During evaluation of \
In[4]:=",ExpressionUUID->"7ffb9820-b71b-4abd-a48a-c93cb39e8546"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"kGGData", "=", 
   RowBox[{"bootstrapData", "[", "\"\<KGG\>\"", "]"}]}], ";", 
  RowBox[{"kPhiGGData", "=", 
   RowBox[{"bootstrapData", "[", "\"\<KPhiGG\>\"", "]"}]}], ";", 
  RowBox[{"m0Data", "=", 
   RowBox[{"bootstrapData", "[", "\"\<M0\>\"", "]"}]}], ";", 
  RowBox[{"mPhiCoefficientData", "=", 
   RowBox[{"bootstrapData", "[", "\"\<MPhiCoefficient\>\"", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"53bda17c-dd2b-42de-8b91-41576add70ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KeyTake", "[", 
  RowBox[{"bootstrapData", ",", 
   RowBox[{"{", 
    RowBox[{
    "\"\<Dimension\>\"", ",", "\"\<Normalization\>\"", ",", "\"\<GGSlots\>\"",
      ",", "\"\<PhiGGSlots\>\"", ",", "\"\<Representation\>\"", ",", 
     "\"\<InverseStatus\>\""}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"479b44d7-23c3-4a3f-84da-7b773ad6f682"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"Dimension\"\>", "\[Rule]", "GPBootstrapData`Dimension"}], 
    ",", 
    RowBox[{"\<\"Normalization\"\>", 
     "\[Rule]", "\<\"cGG = 1/(Nd-1); action Eq. (5.1); kernels have no extra \
factorials; restore kappa multiplying phi G G.\"\>"}], ",", 
    RowBox[{"\<\"GGSlots\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\<\"lambda\"\>", ",", "\<\"mu\"\>", ",", "\<\"nu\"\>", 
       ",", "\<\"rho\"\>", ",", "\<\"sigma\"\>", ",", "\<\"tau\"\>"}], 
      "}"}]}], ",", 
    RowBox[{"\<\"PhiGGSlots\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\<\"mu\"\>", ",", "\<\"nu\"\>", ",", "\<\"lambda\"\>", 
       ",", "\<\"alpha\"\>", ",", "\<\"beta\"\>", ",", "\<\"rho\"\>", 
       ",", "\<\"sigma\"\>", ",", "\<\"tau\"\>"}], "}"}]}], ",", 
    RowBox[{"\<\"Representation\"\>", 
     "\[Rule]", "\<\"Eta[i,j] is the abstract flat metric between free slots \
i,j, not a component with numerical indices. All kernel indices are raised in \
the FeynCalc representation. Integer slots are labels, not summed \
indices.\"\>"}], ",", 
    RowBox[{"\<\"InverseStatus\"\>", 
     "\[Rule]", "\<\"Not exported. Construct or import M0Inverse in the xAct \
notebook and verify its product with this M0 on symmetric connection tensors.\
\"\>"}]}], "\[RightAssociation]"}], TraditionalForm]], "Output",
 CellChangeTimes->{
  3.99838815259768*^9, 3.998388663174529*^9, 3.998388866197773*^9, 
   3.998389279521216*^9, 3.998392945352172*^9, 3.998393481998294*^9, 
   3.998393635121005*^9, 3.998393862654571*^9, 3.998394076195077*^9, 
   3.998394382183545*^9, 3.9983945851610928`*^9, 3.998394818473909*^9, 
   3.998395021803608*^9, {3.998395398527679*^9, 3.9983954251885653`*^9}, 
   3.998395711500306*^9, 3.998395808552146*^9, 3.998396021093264*^9, 
   3.998396438130682*^9, 3.998396586413169*^9, 3.998396815211576*^9, 
   3.998396930187614*^9, 3.9983982295789967`*^9, 3.998399026239193*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"66b4f0e1-c5be-407e-9d3e-85591e06c746"]
}, Open  ]],

Cell["\<\
prettyKernel provides a display of the imported slot polynomials. It does not \
define xAct tensors. Formatting wrappers such as StandardForm and \
TraditionalForm are used for display; the algebra below uses unformatted \
expressions.\
\>", "Text",ExpressionUUID->"14c2b4cb-bb50-44aa-8537-287d0302698e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"prettyKernel", "[", 
    RowBox[{"expr_", ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"TraditionalForm", "[", 
    RowBox[{"expr", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"GPBootstrapData`Dimension", "->", "d"}], ",", 
       RowBox[{
        RowBox[{"GPBootstrapData`Eta", "[", 
         RowBox[{"i_Integer", ",", "j_Integer"}], "]"}], ":>", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<\[Eta]\>\"", ",", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"labels", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"labels", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}]}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998388439678747*^9, 3.998388441301729*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"ce37aa40-572a-4e09-9b4d-465c068e6187"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ggLabels", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<\[Lambda]\>\"", ",", "\"\<\[Mu]\>\"", ",", "\"\<\[Nu]\>\"", ",", 
     "\"\<\[Rho]\>\"", ",", "\"\<\[Sigma]\>\"", ",", "\"\<\[Tau]\>\""}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phiGGLabels", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<\[Mu]\>\"", ",", "\"\<\[Nu]\>\"", ",", "\"\<\[Lambda]\>\"", ",", 
     "\"\<\[Alpha]\>\"", ",", "\"\<\[Beta]\>\"", ",", "\"\<\[Rho]\>\"", ",", 
     "\"\<\[Sigma]\>\"", ",", "\"\<\[Tau]\>\""}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9983884867178707`*^9, 3.998388487838832*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"ce3bcbce-c3a5-42d8-ae1e-842bf2ddeca7"],

