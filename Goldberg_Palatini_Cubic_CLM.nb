Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lag2", " ", "//", " ", "ToCanonical"}], " ", "//", " ", 
   "StandardForm"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9983952706803503`*^9, 3.998395279164872*^9}, {
  3.998395322693261*^9, 3.998395347066905*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"ada9ab96-3cdd-4d8f-bf5d-233ba9a1f3fb"],

