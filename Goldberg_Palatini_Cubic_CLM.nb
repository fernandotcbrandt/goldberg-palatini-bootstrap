Cell["\<\
From CLM, eq. (A14), we find the Lagrangian written in terms of the Goldberg \
metric to be:\
\>", "Text",
 CellChangeTimes->{
  4.001168795316608*^9},ExpressionUUID->"a8863008-d54f-4ba5-bac2-\
c2af30cffd5b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lagCLM", " ", "=", " ", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", "*", 
    RowBox[{"ToCanonical", "[", 
     RowBox[{"ContractMetric", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"+", " ", 
          RowBox[{"h", "[", 
           RowBox[{"\[Rho]", ",", "\[Sigma]"}], "]"}]}], 
         RowBox[{"h", "[", 
          RowBox[{
           RowBox[{"-", "\[Lambda]"}], ",", 
           RowBox[{"-", "\[Alpha]"}]}], "]"}], 
         RowBox[{"h", "[", 
          RowBox[{
           RowBox[{"-", "\[Beta]"}], ",", 
           RowBox[{"-", "\[Tau]"}]}], "]"}], 
         RowBox[{
          RowBox[{"PD", "[", 
           RowBox[{"-", "\[Rho]"}], "]"}], "[", 
          RowBox[{"h", "[", 
           RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], "]"}], 
         RowBox[{
          RowBox[{"PD", "[", 
           RowBox[{"-", "\[Sigma]"}], "]"}], "[", 
          RowBox[{"h", "[", 
           RowBox[{"\[Lambda]", ",", "\[Tau]"}], "]"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"d", "-", "2"}], ")"}]}], 
         RowBox[{"h", "[", 
          RowBox[{"\[Rho]", ",", "\[Sigma]"}], "]"}], 
         RowBox[{"h", "[", 
          RowBox[{
           RowBox[{"-", "\[Alpha]"}], ",", 
           RowBox[{"-", "\[Beta]"}]}], "]"}], 
         RowBox[{"h", "[", 
          RowBox[{
           RowBox[{"-", "\[Lambda]"}], ",", 
           RowBox[{"-", "\[Tau]"}]}], "]"}], 
         RowBox[{
          RowBox[{"PD", "[", 
           RowBox[{"-", "\[Rho]"}], "]"}], "[", 
          RowBox[{"h", "[", 
           RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], "]"}], 
         RowBox[{
          RowBox[{"PD", "[", 
           RowBox[{"-", "\[Sigma]"}], "]"}], "[", 
          RowBox[{"h", "[", 
           RowBox[{"\[Lambda]", ",", "\[Tau]"}], "]"}], "]"}]}], "-", 
        RowBox[{"2", 
         RowBox[{"h", "[", 
          RowBox[{
           RowBox[{"-", "\[Alpha]"}], ",", 
           RowBox[{"-", "\[Tau]"}]}], "]"}], 
         RowBox[{
          RowBox[{"PD", "[", 
           RowBox[{"-", "\[Rho]"}], "]"}], "[", 
          RowBox[{"h", "[", 
           RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], "]"}], 
         RowBox[{
          RowBox[{"PD", "[", 
           RowBox[{"-", "\[Beta]"}], "]"}], "[", 
          RowBox[{"h", "[", 
           RowBox[{"\[Rho]", ",", "\[Tau]"}], "]"}], "]"}]}]}], "//", 
       "FullSimplify"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagCLM", "//", "ScreenDollarIndices"}], "//", 
  "StandardForm"}]}], "Input",
 CellChangeTimes->{{4.001168918964571*^9, 4.0011689226064463`*^9}, {
   4.0011689661460323`*^9, 4.001168971756147*^9}, 4.00116923816404*^9, {
   4.0011695108960943`*^9, 4.0011695134095507`*^9}, {4.0011695488507013`*^9, 
