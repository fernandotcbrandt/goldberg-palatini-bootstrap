               RowBox[{"-", "e"}]}], "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"d", "-", "2"}], ")"}]}]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"CD", "[", 
             RowBox[{"-", "e"}], "]"}], "[", 
            RowBox[{"phi", "[", 
             RowBox[{
              RowBox[{"-", "a"}], ",", "c"}], "]"}], "]"}], " ", 
