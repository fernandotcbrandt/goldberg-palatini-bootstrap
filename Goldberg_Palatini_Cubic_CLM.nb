Cell["\<\
lag2CLM transcribes the ungauge-fixed quadratic coefficient in CLM Eq. \
(2.10). The difference lag2 + lag2CLM/2 need not vanish pointwise: \
integration by parts relates the mixed-derivative and divergence-squared \
forms. VarD computes its Euler-Lagrange derivative with respect to the \
symmetric phi field. A zero result is checked further by exhibiting the \
divergence explicitly.\
\>", "Text",ExpressionUUID->"1d2a825f-5a86-4a6e-937d-d912cf04d839"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lag2CLM", "=", 
   RowBox[{
    RowBox[{"ToCanonical", "[", 
     RowBox[{"ContractMetric", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "a"}], "]"}], "[", 
         RowBox[{"phi", "[", 
          RowBox[{
           RowBox[{"-", "b"}], ",", 
           RowBox[{"-", "c"}]}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", "a", "]"}], "[", 
          RowBox[{"phi", "[", 
           RowBox[{"b", ",", "c"}], "]"}], "]"}], "/", "2"}]}], "-", 
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "a"}], "]"}], "[", 
         RowBox[{"phi", "[", 
          RowBox[{"b", ",", 
           RowBox[{"-", "b"}]}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", "a", "]"}], "[", 
          RowBox[{"phi", "[", 
           RowBox[{"c", ",", 
            RowBox[{"-", "c"}]}], "]"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"d", "-", "2"}], ")"}]}], ")"}]}]}], "-", 
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "a"}], "]"}], "[", 
         RowBox[{"phi", "[", 
          RowBox[{"a", ",", "b"}], "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "c"}], "]"}], "[", 
         RowBox[{"phi", "[", 
          RowBox[{"c", ",", 
           RowBox[{"-", "b"}]}], "]"}], "]"}]}]}], "]"}], "]"}], "//", 
    "Simplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998396330980556*^9, 3.9983963320644283`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"7f1c9380-2962-49a3-b9c1-3166c785efd6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"clmQuadraticDifference", "=", 
   RowBox[{
    RowBox[{"ToCanonical", "[", 
     RowBox[{"ContractMetric", "[", 
      RowBox[{"Expand", "[", 
       RowBox[{"lag2", "+", 
        RowBox[{"lag2CLM", "/", "2"}]}], "]"}], "]"}], "]"}], "//", 
    "Simplify"}]}], ";"}]], "Input",
