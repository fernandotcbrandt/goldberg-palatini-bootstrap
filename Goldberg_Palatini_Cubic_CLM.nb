    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "c", ",", "e", ",", "f", ",", "g", ",", "h", ",", 
      "i", ",", "j", ",", "k", ",", "l", ",", "m", ",", "n", ",", "r", ",", 
      "s", ",", "t", ",", "u", ",", "v", ",", "w", ",", "z"}], "}"}]}], "]"}],
   ";"}]], "Input",
