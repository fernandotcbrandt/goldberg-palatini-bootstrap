   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"phi", "[", 
      RowBox[{"a", ",", "b"}], "]"}], ",", "Spacetime", ",", 
     RowBox[{"Symmetric", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "]"}], ",", 
     RowBox[{"PrintAs", "->", "\"\<\[Phi]\>\""}]}], "]"}], ";"}], 
  "  "}]], "Input",
 CellChangeTimes->{{3.998393910052319*^9, 3.998393912413759*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"55d00dd3-5eaa-4011-a3fd-8d38466217c0"],

