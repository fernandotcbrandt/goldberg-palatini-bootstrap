Cell["\<\
Contracting the metric-field slots of the cubic kernel with eta reproduces \
KGG. This checks consistency between the quadratic and cubic connection \
terms; the contraction alone does not determine the complete cubic kernel, \
since a traceless contribution in those slots would be invisible.\
\>", "Text",
 CellChangeTimes->{{3.9957078684152813`*^9, 
  3.995707876325321*^9}},ExpressionUUID->"23cfad3a-9abf-40b8-9d30-\
7602376ad0ed"],

Cell[CellGroupData[{

Cell["Full First-Order Cubic-Kernel Check", "Subsection",ExpressionUUID->"5e2cd9fe-2030-4114-a080-be70d8373f34"],

Cell["\<\
This checks V(phi,G1,G2) = M(phi)(G1,G2)/2 for arbitrary symmetric fields by \
comparing all eight free indices. The reference is constructed directly from \
Eq. (3.6) of Brandt and McKeon: replace the metric-density factor in each \
term by phi, while retaining the two metric factors that represent Kronecker \
deltas after raising indices. projectPhi extracts the coefficient of a \
symmetric phi. It is not a replacement of every eta factor by phi.

The candidate uses the previously obtained subs and cGG = 1/(Nd-1). The \
expected residual is zero for symbolic Nd != 1. This test concerns the \
first-order phi G G kernel; it is not the second-order three-graviton/CLM \
check.\
\>", "Text",
 CellTags->
  "FullCubicKernelCheckDescription",ExpressionUUID->"efc456cf-b5aa-4f4a-93eb-\
bcd75bf904aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullCubicKernelResidual", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"projectPhi", ",", " ", "reference", ",", " ", "candidate"}], 
      "}"}], ",", "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"projectPhi", "[", 
        RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"x", ",", " ", "m1"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"y", ",", " ", "m2"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"x", ",", " ", "m2"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"y", ",", " ", "m1"}], "]"}]}]}], ")"}], "/", "2"}]}], 
      ";", "\n", 
      RowBox[{"reference", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", "/", "4"}], " ", 
        RowBox[{"(", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"dt", "[", 
               RowBox[{"m5", ",", " ", "m3"}], "]"}], " ", 
              RowBox[{"dt", "[", 
               RowBox[{"m8", ",", " ", "m6"}], "]"}], " ", 
              RowBox[{"projectPhi", "[", 
               RowBox[{"m4", ",", " ", "m7"}], "]"}]}], "\n", "+", " ", 
             RowBox[{
              RowBox[{"dt", "[", 
               RowBox[{"m4", ",", " ", "m3"}], "]"}], " ", 
              RowBox[{"dt", "[", 
               RowBox[{"m8", ",", " ", "m6"}], "]"}], " ", 
              RowBox[{"projectPhi", "[", 
               RowBox[{"m5", ",", " ", "m7"}], "]"}]}], "\n", "+", " ", 
             RowBox[{
              RowBox[{"dt", "[", 
               RowBox[{"m5", ",", " ", "m3"}], "]"}], " ", 
              RowBox[{"dt", "[", 
               RowBox[{"m7", ",", " ", "m6"}], "]"}], " ", 
              RowBox[{"projectPhi", "[", 
               RowBox[{"m4", ",", " ", "m8"}], "]"}]}], "\n", "+", " ", 
             RowBox[{
              RowBox[{"dt", "[", 
               RowBox[{"m4", ",", " ", "m3"}], "]"}], " ", 
              RowBox[{"dt", "[", 
               RowBox[{"m7", ",", " ", "m6"}], "]"}], " ", 
              RowBox[{"projectPhi", "[", 
               RowBox[{"m5", ",", " ", "m8"}], "]"}]}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"Nd", " ", "-", " ", "1"}], ")"}]}], "\n", "-", " ", 
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"m8", ",", " ", "m3"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"m5", ",", " ", "m6"}], "]"}], " ", 
           RowBox[{"projectPhi", "[", 
            RowBox[{"m4", ",", " ", "m7"}], "]"}]}], "\n", "-", " ", 
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"m8", ",", " ", "m3"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"m4", ",", " ", "m6"}], "]"}], " ", 
           RowBox[{"projectPhi", "[", 
            RowBox[{"m5", ",", " ", "m7"}], "]"}]}], "\n", "-", " ", 
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"m7", ",", " ", "m3"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"m5", ",", " ", "m6"}], "]"}], " ", 
           RowBox[{"projectPhi", "[", 
            RowBox[{"m4", ",", " ", "m8"}], "]"}]}], "\n", "-", " ", 
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"m7", ",", " ", "m3"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"m4", ",", " ", "m6"}], "]"}], " ", 
           RowBox[{"projectPhi", "[", 
            RowBox[{"m5", ",", " ", "m8"}], "]"}]}]}], ")"}]}]}], ";", "\n", 
      RowBox[{"candidate", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"V", "[", 
           RowBox[{
           "m1", ",", " ", "m2", ",", " ", "m3", ",", " ", "m4", ",", " ", 
            "m5", ",", " ", "m6", ",", " ", "m7", ",", " ", "m8"}], "]"}], 
          " ", "/.", " ", "subs"}], ")"}], "\n", "/.", " ", 
        RowBox[{"cGG", " ", "->", " ", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"Nd", " ", "-", " ", "1"}], ")"}]}]}]}]}], ";", "\n", 
      RowBox[{"Factor", "[", 
       RowBox[{"Expand", "[", 
        RowBox[{"candidate", " ", "-", " ", "reference"}], "]"}], "]"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Full first-order cubic kernel residual (expected 0): \>\"", ",", " ", 
    "fullCubicKernelResidual"}], "]"}], ";"}]}], "Input",
 CellTags->"FullCubicKernelCheck",
 CellLabel->
  "In[234]:=",ExpressionUUID->"59105af9-b85d-4c50-a7cf-50e8b211c90e"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"Full first-order cubic kernel residual (expected 0): \"\>", 
    "\[InvisibleSpace]", "0"}],
   SequenceForm["Full first-order cubic kernel residual (expected 0): ", 0],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{3.998386435549759*^9, 3.998387134898342*^9, 
