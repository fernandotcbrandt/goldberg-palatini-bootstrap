Cell[CellGroupData[{

Cell["11) Final Kernels and Comparisons", "Section",
 CellChangeTimes->{{3.995703529846883*^9, 
  3.995703536596262*^9}},ExpressionUUID->"04e6c501-bdcd-4bc6-8017-\
559464564d61"],

Cell[TextData[{
 "From F. T. Brandt and D. G. C. McKeon, Radiative corrections and the \
Palatini action, arXiv:1601.04944, Eqs. (3.5)-(3.6), we have:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubscriptBox[
           StyleBox["L", "TI"], 
           RowBox[{"1", 
             StyleBox["E", "TI"], 
             StyleBox["H", "TI"]}]], "\[LongEqual]", "-", 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox[
           StyleBox["h", "TI"], 
           RowBox[{",", "\[Lambda]"}], "\[Mu]\[Nu]"], "+", 
          FractionBox["1", "2"], 
          SubsuperscriptBox[
           StyleBox["M", "TI"], "\[Lambda]\[Sigma]", 
           "\[Mu]\[Nu]\[Rho]\[Tau]"], 
          RowBox[{"(", 
            StyleBox["h", "TI"], ")"}], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Rho]\[Tau]", "\[Sigma]"], "\[LongEqual]", 
          "-", 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox["\[Phi]", 
           RowBox[{",", "\[Lambda]"}], "\[Mu]\[Nu]"], "+", 
          FractionBox["1", "2"], 
          SubsuperscriptBox[
           StyleBox["M", "TI"], "\[Lambda]\[Sigma]", 
           "\[Mu]\[Nu]\[Rho]\[Tau]"], 
          RowBox[{"(", "\[Eta]", ")"}], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Rho]\[Tau]", "\[Sigma]"], "+", 
          FractionBox["1", "2"], 
          SubsuperscriptBox[
           StyleBox["M", "TI"], "\[Lambda]\[Sigma]", 
           "\[Mu]\[Nu]\[Rho]\[Tau]"], 
          RowBox[{"(", "\[Phi]", ")"}], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Rho]\[Tau]", "\[Sigma]"]}], 
        TraditionalForm], "errors" -> {}, "input" -> 
      "L_{1EH} = -G^{\\lambda}_{\\mu\\nu}h^{\\mu\\nu}_{,\\lambda} + \
\\frac{1}{2} \
M^{\\mu\\nu\\rho\\tau}_{\\lambda\\sigma}(h)G^{\\lambda}_{\\mu\\nu}G^{\\sigma}_\
{\\rho\\tau} = -G^{\\lambda}_{\\mu\\nu}\\phi^{\\mu\\nu}_{,\\lambda} + \
\\frac{1}{2} \
M^{\\mu\\nu\\rho\\tau}_{\\lambda\\sigma}(\\eta)G^{\\lambda}_{\\mu\\nu}G^{\\\
sigma}_{\\rho\\tau}+\\frac{1}{2} \
M^{\\mu\\nu\\rho\\tau}_{\\lambda\\sigma}(\\phi)G^{\\lambda}_{\\mu\\nu}G^{\\\
sigma}_{\\rho\\tau}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " "}], TraditionalForm]],ExpressionUUID->
  "b08c7e39-16e2-4aa0-ab38-12148d337046"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["h", "TI"], "\[Mu]\[Nu]"], "\[LongEqual]", 
         SuperscriptBox["\[Eta]", "\[Mu]\[Nu]"], "+", 
         SuperscriptBox["\[Phi]", "\[Mu]\[Nu]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "h^{\\mu\\nu} = \\eta^{\\mu\\nu} +\\phi^{\\mu\\nu}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a326dcd4-9328-4ddd-a292-9ad777e2aaac"],
 ".\nIn particular, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["M", "TI"], "\[Lambda]\[Sigma]", "\[Mu]\[Nu]\[Pi]\[Tau]"], 
         "(", "\[Eta]", ")"}], TraditionalForm], "errors" -> {}, "input" -> 
     "M^{\\mu\\nu\\pi\\tau}_{\\lambda\\sigma}(\\eta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac9182f7-bc9e-44be-bf9c-0e83e185752c"],
 " is defined below. The function M implemented here is M(eta), with all \
displayed indices raised using eta; only its metric-density factor is \
replaced by phi in the later cubic comparison."
}], "Text",
 CellChangeTimes->{{3.995703541891735*^9, 3.995703567014884*^9}, {
  3.995704712216357*^9, 3.995704744435718*^9}, {3.995704848270727*^9, 
  3.9957048776594963`*^9}, {3.9957049233511553`*^9, 3.995704972873536*^9}, {
  3.9957050029506073`*^9, 
  3.995705022249947*^9}},ExpressionUUID->"17f5f14a-b7c8-4bd0-9996-\
56b0baa14944"],

Cell[CellGroupData[{

