Cell[CellGroupData[{

Cell["2) The Action Ansatz", "Section",ExpressionUUID->"65760471-447b-4d6b-9872-378316f47872"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LongEqual]", "1", ",", 
         StyleBox["S", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["S", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["S", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\kappa = 1, S = S_2 + S_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29849a54-fbde-471c-b250-2f549308efa6"],
 ", where, schematically\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "2"], "\[LongEqual]", 
         SubscriptBox["\[Integral]", 
          StyleBox["p", "TI"]], 
         RowBox[{"[", 
           RowBox[{
             SuperscriptBox[
              StyleBox["K", "TI"], "\[Phi]\[Phi]"], 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["\[Phi]", 
                  RowBox[{"-", 
                    StyleBox["p", "TI"]}]], ",", 
                 SubscriptBox["\[Phi]", 
                  StyleBox["p", "TI"]]}], ")"}], "+", 
             SuperscriptBox[
              StyleBox["K", "TI"], 
              RowBox[{"\[Phi]", 
                StyleBox["G", "TI"]}]], 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox["\[Phi]", 
                  RowBox[{"-", 
                    StyleBox["p", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["G", "TI"], 
                  StyleBox["p", "TI"]]}], ")"}], "+", 
             SuperscriptBox[
              StyleBox["K", "TI"], 
              RowBox[{
                StyleBox["G", "TI"], 
                StyleBox["G", "TI"]}]], 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["G", "TI"], 
                  RowBox[{"-", 
                    StyleBox["p", "TI"]}]], ",", 
                 SubscriptBox[
                  StyleBox["G", "TI"], 
                  StyleBox["p", "TI"]]}], ")"}]}], "]"}], ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "S_2=\\int_{p}\\Big[K^{\\phi\\phi}(\\phi_{-p},\\phi_p)+K^{\\phi \
G}(\\phi_{-p},G_p)+K^{GG}(G_{-p},G_p)\\Big],", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6d3fb4c-e312-4deb-adf0-ae74d879b73f"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "3"], "\[LongEqual]", 
         SubscriptBox["\[Integral]", 
          StyleBox["p", "TI"]], 
         SubscriptBox["\[Integral]", 
          StyleBox["q", "TI"]], 
         SuperscriptBox[
          StyleBox["K", "TI"], 
          RowBox[{"\[Phi]", 
            StyleBox["G", "TI"], 
            StyleBox["G", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Phi]", 
              RowBox[{
                StyleBox["p", "TI"], "+", 
                StyleBox["q", "TI"]}]], ",", 
             SubscriptBox[
              StyleBox["G", "TI"], 
              RowBox[{"-", 
                StyleBox["p", "TI"]}]], ",", 
             SubscriptBox[
              StyleBox["G", "TI"], 
              RowBox[{"-", 
                StyleBox["q", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "S_3=\\int_{p}\\int_{q}K^{\\phi GG}(\\phi_{p+q},G_{-p},G_{-q})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0fd27fd-05e2-4d9d-a678-01cb3597941b"],
 "\nEach kernel denotes full contraction with its field arguments, and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Integral]", 
          StyleBox["p", "TI"]], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["d", "TI"]], 
            StyleBox["p", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["d", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\int_p = \\int \\frac{d^d{} p}{(2 \\pi)^d}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f85ef9ba-9ff9-40a6-ac50-dc7b1da33872"],
 ". The quadratic kernels have momentum degrees 2, 1 and 0, respectively; ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["K", "TI"], 
        RowBox[{"\[Phi]", 
          StyleBox["G", "TI"], 
          StyleBox["G", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "K^{\\phi G G}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "53e80153-b506-4e46-b38e-4dabf64b410f"],
 " is momentum independent. The fields are symmetric in their two \
metric/lower-connection slots. No additional factorials are included in this \
kernel convention.\n\nThe local, parity-even ansatz restricts the cubic \
sector to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Phi]", 
         StyleBox["G", "TI"], 
         StyleBox["G", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi G G", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "12ae1fb4-6a4e-44eb-a4ab-440e310ddcf2"],
 ". This is an input, not a consequence of dimensional counting alone. Its \
completion is tested through the six identities below."
}], "Text",
 CellChangeTimes->{{3.99883400566961*^9, 3.9988340185364122`*^9}, {
   3.998835078478506*^9, 3.998835100555518*^9}, 3.9988357939128532`*^9, {
   3.998926543704928*^9, 3.9989265457709513`*^9}, 3.998926584748602*^9},
 CellTags->
  "ActionAnsatz",ExpressionUUID->"76d8a911-a827-4c8f-b71a-2f07f7b8db85"]
}, Open  ]],

