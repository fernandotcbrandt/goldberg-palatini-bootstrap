Cell[CellGroupData[{

Cell["11) Summary and Verification Scope", "Section",
 CellChangeTimes->{{3.9989313661634398`*^9, 
  3.99893136637542*^9}},ExpressionUUID->"5b5047e6-ba93-4261-bfc3-\
ceae5bcffa22"],

Cell[TextData[{
 "Kernel bases: 4, 6, 5 and 16 elements (Tables V-VIII and Appendix C of the \
paper), independent in the stated generic-momentum domain for Nd >= 4. The \
mixed basis includes a factor i. Projection-set sizes at equal field momenta \
are 3, 6, 7, 23, 20 and 95 (Table III); the last set is dependent at Nd = 4.\n\
\nSolution sequence (Table IV): W31 gives Khh = 0. After that restriction, Wh \
and WG impose nine constraints on the eleven mixed/connection coefficients, \
leaving ahG and cGG. W32 sets ahG = 0 and expresses all sixteen cubic \
coefficients through cGG. Substitution in W33 and W34 gives no further \
constraint.\n\nWith cGG = 1/(Nd-1), the only nonzero coefficients are bhG = \
-1, aGG = -1, cGG = 1/(Nd-1), ahGG = -1 and gHGG = 1/(Nd-1). These names \
refer to the notebook basis order. In the orbit notation and slot order of \
Appendix E:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["K", "TI"], "\[Mu]\[Nu]\[Lambda]\[Rho]\[Sigma]", 
          RowBox[{"\[Phi]", 
            StyleBox["G", "TI"]}]], "\[LongEqual]", "-", 
         StyleBox["i", "TI"], 
         StyleBox["S", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["p", "TI"], "\[Lambda]"], 
             SubscriptBox["\[Eta]", "\[Mu]\[Rho]"], 
             SubscriptBox["\[Eta]", "\[Nu]\[Sigma]"]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "K^{\\phi G}_{\\mu\\nu\\lambda\\rho\\sigma} = -i S[p_\\lambda \
\\eta_{\\mu \\rho} \\eta_{\\nu \\sigma}]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2ad7e327-6a80-4fc7-9460-1c231cd9240e"],
 ";\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["K", "TI"], "\[Lambda]\[Mu]\[Nu]\[Rho]\[Sigma]\[Tau]", 
          RowBox[{
            StyleBox["G", "TI"], 
            StyleBox["G", "TI"]}]], "\[LongEqual]", "-", 
         StyleBox["S", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[Eta]", "\[Lambda]\[Sigma]"], 
             SubscriptBox["\[Eta]", "\[Mu]\[Rho]"], 
             SubscriptBox["\[Eta]", "\[Nu]\[Tau]"]}], "]"}], "+", 
         FractionBox["1", 
          RowBox[{
            StyleBox["d", "TI"], "-", "1"}]], 
         StyleBox["S", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[Eta]", "\[Lambda]\[Mu]"], 
             SubscriptBox["\[Eta]", "\[Nu]\[Sigma]"], 
             SubscriptBox["\[Eta]", "\[Rho]\[Tau]"]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "K^{GG}_{\\lambda\\mu\\nu\\rho\\sigma\\tau} = -S[\\eta_{\\lambda \
\\sigma} \\eta_{\\mu \\rho} \\eta_{\\nu \\tau}] + \
\\frac{1}{d-1}S[\\eta_{\\lambda \\mu} \\eta_{\\nu \\sigma} \\eta_{\\rho \
\\tau}]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d3b86cb-cc46-4f1b-b739-a529c9cc8d97"],
 ";\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["K", "TI"], 
          "\[Mu]\[Nu]\[Lambda]\[Alpha]\[Beta]\[Rho]\[Sigma]\[Tau]", 
          RowBox[{"\[Phi]", 
            StyleBox["G", "TI"], 
            StyleBox["G", "TI"]}]], "\[LongEqual]", "-", 
         StyleBox["S", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[Eta]", "\[Mu]\[Alpha]"], 
             SubscriptBox["\[Eta]", "\[Nu]\[Sigma]"], 
             SubscriptBox["\[Eta]", "\[Lambda]\[Tau]"], 
             SubscriptBox["\[Eta]", "\[Beta]\[Rho]"]}], "]"}], "+", 
         FractionBox["1", 
          RowBox[{
            StyleBox["d", "TI"], "-", "1"}]], 
         StyleBox["S", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[Eta]", "\[Mu]\[Alpha]"], 
             SubscriptBox["\[Eta]", "\[Nu]\[Sigma]"], 
             SubscriptBox["\[Eta]", "\[Lambda]\[Beta]"], 
             SubscriptBox["\[Eta]", "\[Rho]\[Tau]"]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "K^{\\phi G G}_{\\mu\\nu\\lambda\\alpha\\beta\\rho\\sigma\\tau} = \
-S[\\eta_{\\mu \\alpha} \\eta_{\\nu \\sigma} \\eta_{\\lambda \\tau} \
\\eta_{\\beta \\rho}] + \\frac{1}{d-1}S[\\eta_{\\mu \\alpha} \\eta_{\\nu \
\\sigma} \\eta_{\\lambda \\beta} \\eta_{\\rho \\tau}]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a85acaa-1a40-4d80-9ec8-983d6b7449d3"],
 ".\nS denotes the average over the relevant kernel-symmetry orbit. The \
corresponding paper elements are mixed 4, GG 5 and 2, and cubic 16 and 14.\n\n\
The action is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], " ", 
         RowBox[{"[", 
           RowBox[{"-", 
             SubsuperscriptBox[
              StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
             SubscriptBox["\[PartialD]", "\[Lambda]"], 
             SuperscriptBox["\[Phi]", "\[Mu]\[Nu]"], "+", 
             FractionBox["1", 
              RowBox[{
                StyleBox["d", "TI"], "-", "1"}]], 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{"\[Eta]", "+", "\[Phi]"}], ")"}], "\[Mu]\[Nu]"], 
             RowBox[{"(", 
               RowBox[{"-", "tr", 
                 RowBox[{"(", 
                   RowBox[{
                    SubscriptBox[
                    StyleBox["G", "TI"], "\[Mu]"], 
                    SubscriptBox[
                    StyleBox["G", "TI"], "\[Nu]"]}], ")"}], "+", 
                 SubscriptBox[
                  StyleBox["g", "TI"], "\[Mu]"], 
                 SubscriptBox[
                  StyleBox["g", "TI"], "\[Nu]"]}], ")"}]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "S = \\int d^d x\\, [-G^\\lambda_{\\mu \\nu} \\partial_\\lambda \
\\phi^{\\mu \\nu} +\\frac{1}{d-1} (\\eta + \\phi)^{\\mu \
\\nu}(-\\text{tr}(G_\\mu G_\\nu) + g_\\mu g_\\nu)]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "689a574b-7dcb-45ff-8b3d-158bcb72954d"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "\[Mu]"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["G", "TI"], "\[Mu]\[Sigma]", "\[Sigma]"], ",", "\[Kappa]", 
         "\[LongEqual]", "1"}], TraditionalForm], "errors" -> {}, "input" -> 
     "g_\\mu = G^\\sigma_{\\mu \\sigma}, \\kappa = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92e4a265-d20b-4116-8cb2-1b16099d8bbc"],
 " and the normalization of Eq. (5.1).\n\nThe full first-order cubic-kernel \
check compares all eight free indices and returns zero when the bootstrap \
kernel equals the Goldberg-Palatini reference. The second-order \
three-graviton vertex and its comparison with CLM are outside the scope of \
this notebook; the final cell exports the kernels for that calculation."
}], "Text",
 CellChangeTimes->{{3.998932017818239*^9, 3.9989320204504433`*^9}, {
   3.9989321385782347`*^9, 3.998932161360229*^9}, {3.9989322238802834`*^9, 
   3.998932226762988*^9}, 3.998932390090618*^9, 3.998932433365322*^9, 
   3.998932532315687*^9, 3.998932740674597*^9, 3.998932848804594*^9, {
   3.998932923251713*^9, 3.9989329242184753`*^9}},
 CellTags->
  "ResultsSummary",ExpressionUUID->"8da13f43-9225-4921-a4e8-a38e043f3f49"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12) Export for the Separate xAct/CLM Notebook", "Section",
 CellChangeTimes->{{3.998931368595964*^9, 
  3.998931368811257*^9}},ExpressionUUID->"792347ae-3dba-4bbc-8b8f-\
14b2ed4c5d04"],

Cell["\<\
Evaluate this final cell after solving the bootstrap with symbolic Nd. It \
writes a package-independent Association beside this notebook and reads it \
back to verify serialization. The export contains the normalized GG and phi \
GG kernels, M0 = 2 KGG, and the phi coefficient of M(phi) = 2 KhGG, with slot \
conventions. The inverse and the second-order CLM comparison belong to the \
separate xAct notebook. The full first-order cubic-kernel check above remains \
part of the bootstrap validation.\
\>", "Text",
 CellChangeTimes->{{3.998932943945401*^9, 
  3.998932946378788*^9}},ExpressionUUID->"436fe0fa-70b8-4521-b380-\
4d3f30dbb973"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"slots", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
        "m1", ",", "m2", ",", "m3", ",", "m4", ",", "m5", ",", "m6", ",", 
         "m7", ",", "m8"}], "}"}]}], ",", " ", "gg", ",", " ", "cubic", ",", 
      " ", "neutral", ",", " ", "data", ",", " ", "file"}], "}"}], ",", "\n", 
    " ", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"!", 
         RowBox[{"ListQ", "[", "subs", "]"}]}], " ", "||", " ", 
        RowBox[{
         RowBox[{"DownValues", "[", "KGG", "]"}], " ", "===", " ", 
         RowBox[{"{", "}"}]}], " ", "||", " ", 
        RowBox[{
         RowBox[{"DownValues", "[", "KhGG", "]"}], " ", "===", " ", 
         RowBox[{"{", "}"}]}]}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{
        "Print", 
         "[", "\"\<Export aborted: evaluate the bootstrap solution first.\>\"",
          "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ValueQ", "[", "Nd", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<Export aborted: Nd must remain symbolic.\>\"", 
         "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", " ", 
     RowBox[{"gg", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KGG", "[", 
          RowBox[{
          "m1", ",", "m2", ",", "m3", ",", "m4", ",", "m5", ",", "m6"}], 
          "]"}], " ", "/.", " ", "subs"}], " ", "/.", " ", 
        RowBox[{"cGG", " ", "->", " ", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"Nd", "-", "1"}], ")"}]}]}]}], "]"}]}], ";", "\n", " ", 
     RowBox[{"cubic", " ", "=", " ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KhGG", "[", 
          RowBox[{
          "m1", ",", "m2", ",", "m3", ",", "m4", ",", "m5", ",", "m6", ",", 
           "m7", ",", "m8"}], "]"}], " ", "/.", " ", "subs"}], " ", "/.", " ", 
        RowBox[{"cGG", " ", "->", " ", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"Nd", "-", "1"}], ")"}]}]}]}], "]"}]}], ";", "\n", " ", 
     RowBox[{
      RowBox[{"neutral", "[", "expr_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"FCI", "[", "expr", "]"}], " ", "/.", " ", 
         RowBox[{"{", "\n", "   ", 
          RowBox[{
           RowBox[{"FeynCalc`Pair", "[", 
            RowBox[{
             RowBox[{"FeynCalc`LorentzIndex", "[", 
              RowBox[{"a_", ",", "Nd"}], "]"}], ",", 
             RowBox[{"FeynCalc`LorentzIndex", "[", 
              RowBox[{"b_", ",", "Nd"}], "]"}]}], "]"}], " ", ":>", " ", 
           RowBox[{"GPBootstrapData`Eta", "[", 
            RowBox[{"a", ",", "b"}], "]"}]}], "\n", "   ", "}"}]}], " ", "/.",
         " ", 
        RowBox[{"Thread", "[", 
         RowBox[{"slots", " ", "->", " ", 
          RowBox[{"Range", "[", "8", "]"}]}], "]"}]}], " ", "/.", " ", 
       RowBox[{"Nd", " ", "->", " ", "GPBootstrapData`Dimension"}]}]}], ";", 
     "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gg", ",", "cubic"}], "}"}], " ", "=", " ", 
      RowBox[{"neutral", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"gg", ",", "cubic"}], "}"}]}]}], ";", "\n", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"FreeQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"gg", ",", "cubic"}], "}"}], ",", " ", 
          RowBox[{"s_Symbol", " ", "/;", " ", 
           RowBox[{"!", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<System`\>\"", ",", "\"\<GPBootstrapData`\>\""}], 
               "}"}], ",", 
              RowBox[{"Context", "[", "s", "]"}]}], "]"}]}]}]}], "]"}]}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{
        "Print", 
         "[", "\"\<Export aborted: unresolved coefficients or unsupported \
tensor objects.\>\"", "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", " ", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"<|", "\n", "  ", 
       RowBox[{
        RowBox[{"\"\<SchemaVersion\>\"", " ", "->", " ", "1"}], ",", "\n", 
        "  ", 
        RowBox[{"\"\<SourceNotebook\>\"", " ", "->", 
         " ", "\"\<Goldberg_Palatini_Bootstrap_en.nb\>\""}], ",", "\n", "  ", 
        
        RowBox[{"\"\<Created\>\"", " ", "->", " ", 
         RowBox[{"DateString", "[", "\"\<ISODateTime\>\"", "]"}]}], ",", "\n",
         "  ", 
        RowBox[{"\"\<KernelVersion\>\"", " ", "->", " ", "$Version"}], ",", 
        "\n", "  ", 
        RowBox[{"\"\<FeynCalcVersion\>\"", " ", "->", " ", 
         "$FeynCalcVersion"}], ",", "\n", "  ", 
        RowBox[{"\"\<Dimension\>\"", " ", "->", " ", 
         "GPBootstrapData`Dimension"}], ",", "\n", "  ", 
        RowBox[{"\"\<Domain\>\"", " ", "->", 
         " ", "\"\<Generic symbolic dimension d >= 4; inverse construction \
requires d != 2.\>\""}], ",", "\n", "  ", 
        RowBox[{"\"\<Normalization\>\"", " ", "->", 
         " ", "\"\<cGG = 1/(Nd-1); action Eq. (5.1); kernels have no extra \
factorials; restore kappa multiplying phi G G.\>\""}], ",", "\n", "  ", 
        RowBox[{"\"\<Representation\>\"", " ", "->", 
         " ", "\"\<Eta[i,j] is the abstract flat metric between free slots \
i,j, not a component with numerical indices. All kernel indices are raised in \
the FeynCalc representation. Integer slots are labels, not summed \
indices.\>\""}], ",", "\n", "  ", 
        RowBox[{"\"\<GGSlots\>\"", " ", "->", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<lambda\>\"", ",", "\"\<mu\>\"", ",", "\"\<nu\>\"", 
           ",", "\"\<rho\>\"", ",", "\"\<sigma\>\"", ",", "\"\<tau\>\""}], 
          "}"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<PhiGGSlots\>\"", " ", "->", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<mu\>\"", ",", "\"\<nu\>\"", ",", "\"\<lambda\>\"", 
           ",", "\"\<alpha\>\"", ",", "\"\<beta\>\"", ",", "\"\<rho\>\"", 
           ",", "\"\<sigma\>\"", ",", "\"\<tau\>\""}], "}"}]}], ",", "\n", 
        "  ", 
        RowBox[{"\"\<GGSymmetries\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "6"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"4", ",", "5", ",", "6"}], "}"}]}], "}"}]}], "}"}]}], ",",
         "\n", "  ", 
        RowBox[{"\"\<PhiGGSymmetries\>\"", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"7", ",", "8"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"3", ",", "4", ",", "5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"6", ",", "7", ",", "8"}], "}"}]}], "}"}]}], "}"}]}], ",",
         "\n", "  ", 
        RowBox[{"\"\<KGG\>\"", " ", "->", " ", "gg"}], ",", "\n", "  ", 
        RowBox[{"\"\<KPhiGG\>\"", " ", "->", " ", "cubic"}], ",", "\n", "  ", 
        
        RowBox[{"\"\<M0\>\"", " ", "->", " ", 
         RowBox[{"2", " ", "gg"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<MPhiCoefficient\>\"", " ", "->", " ", 
         RowBox[{"2", " ", "cubic"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<MPhiMeaning\>\"", " ", "->", 
         " ", "\"\<Contract slots 1,2 of MPhiCoefficient with the lowered \
symmetric phi to form M(phi); the remaining slots describe the two G \
fields.\>\""}], ",", "\n", "  ", 
        RowBox[{"\"\<InverseStatus\>\"", " ", "->", 
         " ", "\"\<Not exported. Construct or import M0Inverse in the xAct \
notebook and verify its product with this M0 on symmetric connection tensors.\
\>\""}], ",", "\n", "  ", 
        RowBox[{"\"\<MixedTerm\>\"", " ", "->", 
         " ", "\"\<-G^lambda_mu_nu partial_lambda phi^mu_nu in position \
space, after integration by parts.\>\""}], ",", "\n", "  ", 
        RowBox[{"\"\<FourierConvention\>\"", " ", "->", 
         " ", "\"\<f(p)=integral exp(+i p.x) f(x); partial on momentum p \
gives -i p.\>\""}], ",", "\n", "  ", 
        RowBox[{"\"\<CubicAction\>\"", " ", "->", 
         " ", "\"\<G0=M0Inverse partial(phi); L3=kappa M(phi)(G0,G0)/2. CLM \
comparison is performed in a separate notebook.\>\""}]}], "\n", " ", "|>"}]}],
      ";", "\n", " ", 
     RowBox[{"file", " ", "=", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], 
         ",", "\"\<Goldberg_Palatini_Bootstrap_kernels.wl\>\""}], "}"}], 
       "]"}]}], ";", "\n", " ", 
     RowBox[{"Put", "[", 
      RowBox[{"data", ",", "file"}], "]"}], ";", "\n", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Get", "[", "file", "]"}], " ", "=!=", " ", "data"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<Export read-back failed.\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Bootstrap kernels exported and read back successfully: \
\>\"", ",", 
       RowBox[{"FileNameTake", "[", "file", "]"}]}], "]"}], ";", "\n", " ", 
     RowBox[{"FileNameTake", "[", "file", "]"}]}]}], "\n", "]"}], 
  "\n"}]], "Input",
 CellChangeTimes->{{3.998932960568655*^9, 3.99893298319521*^9}},
 CellLabel->
  "In[212]:=",ExpressionUUID->"09ed0f00-382c-4fc2-8462-1d4b717a8d11"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"Bootstrap kernels exported and read back successfully: \"\>", 
    "\[InvisibleSpace]", "\<\"Goldberg_Palatini_Bootstrap_kernels.wl\"\>"}],
   SequenceForm[
   "Bootstrap kernels exported and read back successfully: ", 
    "Goldberg_Palatini_Bootstrap_kernels.wl"],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{3.998387135498892*^9, 3.998387735991354*^9, 
