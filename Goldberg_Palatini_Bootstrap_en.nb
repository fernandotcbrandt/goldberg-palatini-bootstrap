Cell[BoxData[{
 RowBox[{"Gramhh", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{
       RowBox[{"basishh", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basishh", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "//", "FullSimplify"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "basishh", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"Length", "[", "basishh", "]"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", "Gramhh", "]"}], "//", "Factor"}]}], "Input",
