       "bhG", ",", "chG", ",", "dhG", ",", "ehG", ",", "fhG", ",", "aGG", ",",
         "bGG", ",", "dGG", ",", "eGG"}], "}"}]}], "]"}], "]"}], "//", 
   "FullSimplify"}]}]], "Input",
