Cell["\<\
Contracting the metric-field slots of the cubic kernel with eta reproduces \
KGG. This checks consistency between the quadratic and cubic connection \
terms; the contraction alone does not determine the complete cubic kernel, \
since a traceless contribution in those slots would be invisible.\
\>", "Text",
 CellChangeTimes->{{3.9957078684152813`*^9, 
  3.995707876325321*^9}},ExpressionUUID->"23cfad3a-9abf-40b8-9d30-\
7602376ad0ed"],

Cell[CellGroupData[{

Cell["Full First-Order Cubic-Kernel Check", "Subsection",ExpressionUUID->"5e2cd9fe-2030-4114-a080-be70d8373f34"],

Cell[TextData[{
 "This checks ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["K", "TI"], 
          RowBox[{"\[Phi]", 
            StyleBox["G", "TI"], 
            StyleBox["G", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{"\[Phi]", ",", 
             StyleBox["G", "TI"], "1", ",", 
             StyleBox["G", "TI"], "2"}], ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         StyleBox["M", "TI"], 
         RowBox[{"(", "\[Phi]", ")"}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["G", "TI"], "1", ",", 
             StyleBox["G", "TI"], "2"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "K^{\\phi GG}(\\phi,G1,G2) = \\frac{1}{2}M(\\phi)(G1,G2)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab5d2df8-b2d3-4d28-84af-e2ae4d459741"],
 "for arbitrary symmetric fields by comparing all eight free indices. The \
reference is constructed directly from Eq. (3.6) of Brandt and McKeon: \
replace the metric-density factor in each term by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8eedb964-2b2b-43ce-87a2-b20c0862a9e7"],
 ", while retaining the two metric factors that represent Kronecker deltas \
after raising indices. projectPhi extracts the coefficient of a symmetric ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "046c2256-5dde-4f3c-8584-865b24d9861c"],
 ". It is not a replacement of every ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Eta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\eta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f242fcde-e51f-4c2a-adfe-ad7cde3f1c2e"],
 " factor by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e240e0d9-ee6a-415c-83fa-c19400809240"],
 ".\n\nThe candidate uses the previously obtained subs and cGG = 1/(Nd-1). \
The expected residual is zero for symbolic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[NotEqual]", "1."}], TraditionalForm], 
     "errors" -> {}, "input" -> "d \\neq 1.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d155ae8c-cc92-46a0-a831-8f9c799ef72e"],
 " (Nd \[NotEqual] 1).This test concerns the first-order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["K", "TI"], 
        RowBox[{"\[Phi]", 
          StyleBox["G", "TI"], 
          StyleBox["G", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "K^{\\phi G G}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88b1acaa-2ee7-475d-bb4d-b2ad2f467b1c"],
 "; it is not the second-order three-graviton/CLM check."
}], "Text",
 CellChangeTimes->{{3.998931422084263*^9, 3.998931438480772*^9}, {
  3.998931482233611*^9, 3.9989315686484833`*^9}},
 CellTags->
  "FullCubicKernelCheckDescription",ExpressionUUID->"efc456cf-b5aa-4f4a-93eb-\
bcd75bf904aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullCubicKernelResidual", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"projectPhi", ",", " ", "reference", ",", " ", "candidate"}], 
      "}"}], ",", "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"projectPhi", "[", 
        RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"x", ",", " ", "m1"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"y", ",", " ", "m2"}], "]"}]}], " ", "+", " ", 
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"x", ",", " ", "m2"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"y", ",", " ", "m1"}], "]"}]}]}], ")"}], "/", "2"}]}], ";",
       "\n", 
      RowBox[{"reference", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", "/", "4"}], " ", 
        RowBox[{"(", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"dt", "[", 
               RowBox[{"m5", ",", " ", "m3"}], "]"}], " ", 
              RowBox[{"dt", "[", 
               RowBox[{"m8", ",", " ", "m6"}], "]"}], " ", 
              RowBox[{"projectPhi", "[", 
               RowBox[{"m4", ",", " ", "m7"}], "]"}]}], "\n", "+", " ", 
             RowBox[{
              RowBox[{"dt", "[", 
               RowBox[{"m4", ",", " ", "m3"}], "]"}], " ", 
              RowBox[{"dt", "[", 
               RowBox[{"m8", ",", " ", "m6"}], "]"}], " ", 
              RowBox[{"projectPhi", "[", 
               RowBox[{"m5", ",", " ", "m7"}], "]"}]}], "\n", "+", " ", 
             RowBox[{
              RowBox[{"dt", "[", 
               RowBox[{"m5", ",", " ", "m3"}], "]"}], " ", 
              RowBox[{"dt", "[", 
               RowBox[{"m7", ",", " ", "m6"}], "]"}], " ", 
              RowBox[{"projectPhi", "[", 
               RowBox[{"m4", ",", " ", "m8"}], "]"}]}], "\n", "+", " ", 
             RowBox[{
              RowBox[{"dt", "[", 
               RowBox[{"m4", ",", " ", "m3"}], "]"}], " ", 
              RowBox[{"dt", "[", 
               RowBox[{"m7", ",", " ", "m6"}], "]"}], " ", 
              RowBox[{"projectPhi", "[", 
               RowBox[{"m5", ",", " ", "m8"}], "]"}]}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"Nd", " ", "-", " ", "1"}], ")"}]}], "\n", "-", " ", 
          RowBox[{
           RowBox[{"dt", "[", 
            RowBox[{"m8", ",", " ", "m3"}], "]"}], " ", 
           RowBox[{"dt", "[", 
            RowBox[{"m5", ",", " ", "m6"}], "]"}], " ", 
           RowBox[{"projectPhi", "[", 
            RowBox[{"m4", ",", " ", "m7"}], "]"}]}], "\n", "-", " ", 
          RowBox[{
