 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"bhG", "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", 
      RowBox[{"(", 
       RowBox[{"Nd", "-", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "ahG"}], "+", 
        RowBox[{"2", " ", "cGG"}]}], ")"}]}]}], ",", 
    RowBox[{"chG", "\[Rule]", "0"}], ",", 
    RowBox[{"dhG", "\[Rule]", 
     RowBox[{"ahG", "-", 
      RowBox[{"ahG", " ", "Nd"}]}]}], ",", 
    RowBox[{"ehG", "\[Rule]", 
     RowBox[{"ahG", " ", 
