Cell[TextData[{
 "Note also that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["K", "TI"], "\[Lambda]\[Alpha]\[Beta]\[Rho]\[Sigma]\[Tau]", 
          RowBox[{
            StyleBox["G", "TI"], 
            StyleBox["G", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox["\[Eta]", "\[Mu]\[Nu]"], 
         SubscriptBox[
          StyleBox["V", "TI"], 
          "\[Mu]\[Nu]\[Lambda]\[Alpha]\[Beta]\[Rho]\[Sigma]\[Tau]"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "K^{GG}_{\\lambda\\alpha\\beta\\rho\\sigma\\tau}=\\eta^{\\mu\\nu}V_{\\mu\
\\nu\\lambda\\alpha\\beta\\rho\\sigma\\tau}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "518b2855-eead-4125-90dd-ffb66e175540"],
 ". We can therefore check consistency:"
}], "Text",
