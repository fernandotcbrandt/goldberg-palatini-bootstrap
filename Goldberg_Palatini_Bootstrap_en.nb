 RowBox[{"orbithG", " ", "=", " ", 
  RowBox[{"DeleteDuplicates", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"proto", "/.", 
        RowBox[{"Thread", "[", 
         RowBox[{"indiceshG", " ", "->", " ", "perm"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"proto", ",", "protohG"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"perm", ",", "permshG"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
   "]"}]}]], "Input",
