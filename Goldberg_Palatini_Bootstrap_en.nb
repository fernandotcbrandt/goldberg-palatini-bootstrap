    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a326dcd4-9328-4ddd-a292-9ad777e2aaac"],
 ".\nIn particular, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["M", "TI"], "\[Lambda]\[Sigma]", "\[Mu]\[Nu]\[Pi]\[Tau]"], 
