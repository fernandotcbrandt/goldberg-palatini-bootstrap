Cell[CellGroupData[{

Cell[TextData[{
 "8) Cubic Vertex - ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "3"], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["D", "TI"]], 
            StyleBox["p", "TI"], 
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["D", "TI"]], 
            StyleBox["q", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           RowBox[{"2", 
             StyleBox["D", "TI"]}]]], 
         SuperscriptBox[
          OverscriptBox["\[Phi]", "~"], "\[Mu]\[Nu]"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["p", "TI"], "+", 
             StyleBox["q", "TI"]}], ")"}], 
         SubsuperscriptBox[
          StyleBox["V", "TI"], "\[Mu]\[Nu]\[Lambda]\[Rho]", 
          "\[Alpha]\[Beta]\[Sigma]\[Tau]"], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["G", "TI"], "~"], "\[Alpha]\[Beta]", "\[Lambda]"], 
         RowBox[{"(", 
           RowBox[{"-", 
             StyleBox["p", "TI"]}], ")"}], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["G", "TI"], "~"], "\[Sigma]\[Tau]", "\[Rho]"], 
         RowBox[{"(", 
           RowBox[{"-", 
             StyleBox["q", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "S_{3} = \\int \\frac{d^{D} p d^{D} q}{(2\\pi)^{2D}} \
\\tilde{\\phi}^{\\mu\\nu} (p+q) \
V_{\\mu\\nu\\lambda\\rho}^{\\alpha\\beta\\sigma \\tau} \
\\tilde{G}^{\\lambda}_{\\alpha\\beta} (-p) \\tilde{G}^{\\rho}_{\\sigma\\tau} \
(-q)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9c7c6ad2-6253-44e7-893e-98ed21408735"]
}], "Section",
 CellChangeTimes->{{3.994931650968871*^9, 3.994931657256434*^9}, {
  3.994931720976202*^9, 
  3.994931726583253*^9}},ExpressionUUID->"b4d2582c-5177-4bdb-bc10-\
62c7ff8e7be1"],

