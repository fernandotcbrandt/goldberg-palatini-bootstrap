Cell[CellGroupData[{

Cell["5) Noether Identities (Classical Ward Identities)", "Section",
 CellChangeTimes->{{3.9936711713790483`*^9, 3.9936711781928263`*^9}, 
   3.9949325772996693`*^9},ExpressionUUID->"2bc977e4-7278-46d8-8de4-\
5b89a2d439a1"],

Cell[CellGroupData[{

Cell["Constraints on the vertices:", "Subsection",
 CellChangeTimes->{{3.993708997043008*^9, 
  3.993709020019251*^9}},ExpressionUUID->"d94ba343-ea12-4c49-9be0-\
e055c393cb41"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wardH", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Rho]_", ",", "\[Sigma]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Contract", "[", 
    RowBox[{
     RowBox[{"2", "*", 
      RowBox[{"delh0p", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], "]"}], 
      RowBox[{"Khh", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]"}], 
       "]"}]}], "+", 
     RowBox[{
      RowBox[{"delG0p", "[", 
       RowBox[{"\[Lambda]", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], 
       "]"}], 
      RowBox[{"KhG", "[", 
       RowBox[{
       "\[Rho]", ",", "\[Sigma]", ",", "\[Lambda]", ",", "\[Mu]", ",", 
        "\[Nu]"}], "]"}]}]}], "]"}], "//", 
   "Expand"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wardG", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Rho]_", ",", "\[Sigma]_", ",", "\[Tau]_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"Contract", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"delh0p", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], "]"}], 
      RowBox[{"KGh", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]", ",", "\[Tau]"}],
        "]"}]}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"delG0p", "[", 
       RowBox[{"\[Lambda]", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], 
       "]"}], 
      RowBox[{"KGG", "[", 
       RowBox[{
       "\[Lambda]", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", 
        "\[Sigma]", ",", "\[Tau]"}], "]"}]}]}], "]"}], "//", 
   "Expand"}]}]}], "Input",
 CellChangeTimes->{{3.993672886486781*^9, 3.993672991233796*^9}, {
  3.9936733396761227`*^9, 3.99367335190432*^9}, {3.993673403448575*^9, 
  3.9936734349232264`*^9}, {3.993708955279715*^9, 3.993708967328212*^9}, {
