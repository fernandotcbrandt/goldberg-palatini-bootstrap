Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Delta]", 
          RowBox[{"(", "1", ")"}]], 
         SuperscriptBox[
          OverscriptBox["\[Phi]", "~"], "\[Mu]\[Nu]"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["D", "TI"]], 
            StyleBox["q", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["D", "TI"]]], 
         SuperscriptBox[
          OverscriptBox["\[Phi]", "~"], "\[Alpha]\[Beta]"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["p", "TI"], "-", 
             StyleBox["q", "TI"]}], ")"}], 
         SuperscriptBox[
          OverscriptBox["\[Omega]", "~"], "\[Rho]"], 
         RowBox[{"(", 
           StyleBox["q", "TI"], ")"}], 
         SubsuperscriptBox[
          StyleBox["D", "TI"], "\[Alpha]\[Beta]\[Rho]", 
          RowBox[{
            SuperscriptBox["\[Phi]", "1"], "\[Mu]\[Nu]"}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["p", "TI"], ",", 
             StyleBox["q", "TI"]}], ")"}], ";  ", "\n", 
         SubsuperscriptBox[
          StyleBox["D", "TI"], "\[Alpha]\[Beta]\[Rho]", 
          RowBox[{
            SuperscriptBox["\[Phi]", "1"], "\[Mu]\[Nu]"}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["p", "TI"], ",", 
             StyleBox["q", "TI"]}], ")"}], "\[LongEqual]", "-", 
         StyleBox["i", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubsuperscriptBox["\[Delta]", "\[Alpha]", "\[Mu]"], 
             SubsuperscriptBox["\[Delta]", "\[Beta]", "\[Nu]"], 
             SubscriptBox[
              StyleBox["p", "TI"], "\[Rho]"], "-", 
             SubscriptBox[
              StyleBox["q", "TI"], "\[Beta]"], 
             RowBox[{"(", 
               RowBox[{
                 SubsuperscriptBox["\[Delta]", "\[Alpha]", "\[Mu]"], 
                 SubsuperscriptBox["\[Delta]", "\[Rho]", "\[Nu]"], "+", 
                 SubsuperscriptBox["\[Delta]", "\[Alpha]", "\[Nu]"], 
                 SubsuperscriptBox["\[Delta]", "\[Rho]", "\[Mu]"]}], ")"}]}], 
           ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta^{(1)}\\tilde{\\phi}^{\\mu\\nu}(p) = \\int \
\\frac{d^{D}q}{(2\\pi)^{D}} \\tilde{\\phi}^{\\alpha\\beta}(p-q) \
\\tilde{\\omega}^{\\rho}(q) D^{\\phi^{1} \\mu\\nu}_{\\alpha\\beta\\rho} \
(p,q);\\,\\, \\\\ D_{\\alpha\\beta\\rho}^{\\phi^{1} \\mu\\nu} (p,q) =-i( \
\\delta^{\\mu} _{\\alpha} \\delta^{\\nu} _{\\beta} p_{\\rho} - q_{\\beta} \
(\\delta^{\\mu}_{\\alpha} \\delta^{\\nu}_{\\rho}+\\delta^{\\nu}_{\\alpha} \
\\delta^{\\mu}_{\\rho}))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2739b98f-9a6c-42a7-b8a2-356ab6b084d7"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Delta]", 
          RowBox[{"(", "1", ")"}]], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["G", "TI"], "~"], "\[Mu]\[Nu]", "\[Lambda]"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["d", "TI"], 
             StyleBox["D", "TI"]], 
            StyleBox["q", "TI"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"2", "\[Pi]"}], ")"}], 
           StyleBox["D", "TI"]]], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["G", "TI"], "~"], "\[Beta]\[Gamma]", "\[Alpha]"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["p", "TI"], "-", 
             StyleBox["q", "TI"]}], ")"}], 
         SuperscriptBox[
          OverscriptBox["\[Omega]", "~"], "\[Rho]"], 
         RowBox[{"(", 
           StyleBox["q", "TI"], ")"}], 
         SubsuperscriptBox[
          StyleBox["D", "TI"], "\[Mu]\[Nu]\[Alpha]\[Rho]", 
          RowBox[{
            SuperscriptBox[
             StyleBox["G", "TI"], "1"], "\[Lambda]\[Beta]\[Gamma]"}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["p", "TI"], ",", 
             StyleBox["q", "TI"]}], ")"}], ";  ", "\n", 
         SubsuperscriptBox[
          StyleBox["D", "TI"], "\[Mu]\[Nu]\[Alpha]\[Rho]", 
          RowBox[{
            SuperscriptBox[
             StyleBox["G", "TI"], "1"], "\[Lambda]\[Beta]\[Gamma]"}]], 
         "\[LongEqual]", "-", 
         StyleBox["i", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubsuperscriptBox["\[Delta]", "\[Alpha]", "\[Lambda]"], 
             SubsuperscriptBox["\[Delta]", "\[Mu]", "\[Beta]"], 
             SubsuperscriptBox["\[Delta]", "\[Nu]", "\[Gamma]"], 
             SubscriptBox[
              RowBox[{"(", 
                RowBox[{
                  StyleBox["p", "TI"], "-", 
                  StyleBox["q", "TI"]}], ")"}], "\[Rho]"], "-", 
             SubscriptBox[
              StyleBox["q", "TI"], "\[Alpha]"], 
             SubsuperscriptBox["\[Delta]", "\[Mu]", "\[Beta]"], 
             SubsuperscriptBox["\[Delta]", "\[Nu]", "\[Gamma]"], 
             SubsuperscriptBox["\[Delta]", "\[Rho]", "\[Lambda]"], "+", 
             SubsuperscriptBox["\[Delta]", "\[Alpha]", "\[Lambda]"], 
             SubsuperscriptBox["\[Delta]", "\[Rho]", "\[Beta]"], 
             SubsuperscriptBox["\[Delta]", "\[Nu]", "\[Gamma]"], 
             SubscriptBox[
              StyleBox["q", "TI"], "\[Mu]"], "+", 
             SubsuperscriptBox["\[Delta]", "\[Alpha]", "\[Lambda]"], 
             SubsuperscriptBox["\[Delta]", "\[Mu]", "\[Beta]"], 
             SubsuperscriptBox["\[Delta]", "\[Rho]", "\[Gamma]"], 
             SubscriptBox[
              StyleBox["q", "TI"], "\[Nu]"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta^{(1)} \\tilde{G}^{\\lambda}_{\\mu\\nu} (p) = \\int \\frac{d^{D} \
q}{(2\\pi)^{D}} \\tilde{G}^{\\alpha}_{\\beta\\gamma} (p-q) \\tilde{\\omega}^{\
\\rho} (q) D_{\\mu\\nu\\alpha\\rho}^{G^{1} \\lambda \\beta \\gamma} (p,q);\\,\
\\,\\\\  D_{\\mu\\nu\\alpha\\rho}^{G^{1} \\lambda \\beta \\gamma} = -i \
(\\delta^{\\lambda}_{\\alpha} \\delta^{\\beta}_{\\mu} \
\\delta^{\\gamma}_{\\nu} (p-q)_{\\rho} - q_{\\alpha} \\delta^{\\beta}_{\\mu} \
\\delta^{\\gamma}_{\\nu} \\delta^{\\lambda}_{\\rho} + \
\\delta^{\\lambda}_{\\alpha} \\delta^{\\beta}_{\\rho} \
\\delta^{\\gamma}_{\\nu} q_{\\mu} + \\delta^{\\lambda}_{\\alpha} \
\\delta^{\\beta}_{\\mu} \\delta^{\\gamma}_{\\rho} q_{\\nu})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ddacad8-bbef-43ce-ba88-cf4343c29fad"]
}], "Text",
 CellChangeTimes->{
