Cell[TextData[{
 "With the quadratic kernel determined, we now solve the two Ward identities \
obtained from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Delta]", 
          RowBox[{"(", "0", ")"}]], 
         SubscriptBox[
          StyleBox["S", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\delta^{(0)} S_{2} = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f36d8e42-7461-4160-b1f1-3a9dfcfa4ee6"],
 ". We obtain:"
}], "Text",
 CellChangeTimes->{{3.995701022052498*^9, 
  3.995701066869857*^9}},ExpressionUUID->"9388c9f5-f9f1-4286-981d-\
856a861c7478"],

