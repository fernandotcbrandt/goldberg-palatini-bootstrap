Cell["\<\
Orbit: permute all index slots of the proto-tensors (products of eta and \
momentum with the required index count and momentum degree), then remove \
duplicates. This enumerates the candidate monomials; the kernel-symmetry \
orbits are averaged in the next step.\
\>", "Text",
 CellChangeTimes->{{3.9931168303320503`*^9, 
  3.9931168327707376`*^9}},ExpressionUUID->"d5608741-52d0-4dc1-b1b2-\
24ddb94de9d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"indiceshG", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"m1", ",", "m2", ",", "m3", ",", "m4", ",", "m5"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permshG", " ", "=", " ", 
   RowBox[{"Permutations", "[", "indiceshG", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"protohG", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dt", "[", 
      RowBox[{"m1", ",", "m2"}], "]"}], 
     RowBox[{"p", "[", "m3", "]"}], 
     RowBox[{"dt", "[", 
      RowBox[{"m4", ",", "m5"}], "]"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.993116835725431*^9, 3.993116917015326*^9}, {
  3.993117477462863*^9, 3.99311747889575*^9}, {3.993117661785041*^9, 
  3.9931176915915813`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"0437cd8b-9961-4353-9a62-2c5111c07b0b"],

