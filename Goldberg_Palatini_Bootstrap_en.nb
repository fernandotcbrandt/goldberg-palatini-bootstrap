Cell["\<\
Linear independence: form the Gram matrix by contracting all indices between \
pairs of basis elements. A nonzero determinant proves independence. \
\>", "Text",
 CellChangeTimes->{{3.993119812289404*^9, 3.993119816336316*^9}, 
   3.998928650311738*^9},ExpressionUUID->"820e03d0-a080-49d0-8938-\
c9ebb63b6f66"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GramKhGG", "  ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{
       RowBox[{"basisKhGG", " ", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basisKhGG", " ", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "basisKhGG", " ", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Length", "[", "basisKhGG", " ", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", "GramKhGG", " ", "]"}], "//", "Factor"}]}], "Input",
 CellChangeTimes->{{3.993118377709011*^9, 3.993118526693413*^9}, {
   3.993119818313586*^9, 3.993119833940524*^9}, {3.993119947255591*^9, 
