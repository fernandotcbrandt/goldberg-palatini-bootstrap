Cell["\<\
Symmetrization: average each monomial over the kernel's index-symmetry group. \
Distinct orbits give independent formal expressions; their tensor \
independence is checked below (Appendix C of the paper).\
\>", "Text",
 CellChangeTimes->{{3.992958565454689*^9, 
  3.992958569003663*^9}},ExpressionUUID->"9b3d40f3-d6f7-44a4-bbcc-\
14a9201e2f1b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"symhh", "[", "expr_", "]"}], ":=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"sym2", "[", 
       RowBox[{
        RowBox[{"expr", " ", "+", " ", 
         RowBox[{"swap", "[", 
          RowBox[{"expr", ",", "m1", ",", "m2"}], "]"}], "+", 
         RowBox[{"swap", "[", 
          RowBox[{"expr", ",", "m3", ",", "m4"}], "]"}], "+", 
         RowBox[{"swap", "[", 
          RowBox[{
           RowBox[{"swap", "[", 
            RowBox[{"expr", ",", "m1", ",", "m2"}], "]"}], ",", "m3", ",", 
           "m4"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m1", ",", "m2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m3", ",", "m4"}], "}"}]}], "]"}], ")"}], "/", "4"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"basishh", " ", "=", " ", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"Union", "[", 
     RowBox[{"symhh", "/@", " ", "orbithh"}], "]"}], ",", "0"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The number of basis elements is \>\"", ",", 
   RowBox[{"Length", "[", "basishh", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.99295857291147*^9, 3.992958747919642*^9}, {
