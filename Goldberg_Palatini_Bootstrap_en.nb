Cell["\<\
Linear independence: form the Gram matrix by contracting all indices between \
pairs of basis elements. A nonzero determinant proves independence. \
\>", "Text",
 CellChangeTimes->{{3.993119812289404*^9, 3.993119816336316*^9}, 
   3.998927077702735*^9},ExpressionUUID->"2c0bd5f8-a742-4fc8-8be2-\
88a13bb117fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GramhG", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{
       RowBox[{"basishG", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basishG", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "//", "FullSimplify"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "basishG", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"Length", "[", "basishG", "]"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", "GramhG", "]"}], "//", "Factor"}]}], "Input",
