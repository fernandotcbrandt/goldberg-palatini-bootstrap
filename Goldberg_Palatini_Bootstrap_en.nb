        RowBox[{"dt", "[", 
         RowBox[{"\[Mu]", ",", "\[Sigma]"}], "]"}], 
        RowBox[{"dt", "[", 
         RowBox[{"\[Nu]", ",", "\[Rho]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"dt", "[", 
         RowBox[{"\[Rho]", ",", "\[Lambda]"}], "]"}], 
        RowBox[{"dt", "[", 
         RowBox[{"\[Nu]", ",", "\[Sigma]"}], "]"}], 
        RowBox[{"dt", "[", 
         RowBox[{"\[Mu]", ",", "\[Tau]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"dt", "[", 
         RowBox[{"\[Rho]", ",", "\[Lambda]"}], "]"}], 
        RowBox[{"dt", "[", 
         RowBox[{"\[Mu]", ",", "\[Sigma]"}], "]"}], 
        RowBox[{"dt", "[", 
         RowBox[{"\[Nu]", ",", "\[Tau]"}], "]"}]}]}], ")"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"M", "[", 
  RowBox[{
  "\[Lambda]", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Sigma]", ",", "\[Rho]", 
   ",", "\[Tau]"}], "]"}]}], "Input",
