        RowBox[{"Thread", "[", 
         RowBox[{"indiceswh", " ", "->", " ", "perm"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"proto", ",", "protowh"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"perm", ",", "permswh"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"symwh", "[", "expr_", "]"}], ":=", " ", 
