Cell[CellGroupData[{

Cell["Decomposition Bases", "Subsection",
 CellChangeTimes->{{3.9937090531564617`*^9, 
  3.993709057996758*^9}},ExpressionUUID->"89a391dd-20c2-4546-b2e0-\
a6063bfff37a"],

Cell[CellGroupData[{

Cell["W_h: the phi sector", "Subsubsection",
 CellChangeTimes->{{3.993710893434005*^9, 
  3.993710913558187*^9}},ExpressionUUID->"8199398b-fe47-46b0-87c5-\
fed6a61f79bc"],

Cell["\<\
W_h is the coefficient of phi(-p) omega(p) in delta^(0) S_2 = 0:
W_h_{rho sigma alpha}(p) = 2 D_{phi^0}^{mu nu}_alpha(p) Khh_{mu nu rho \
sigma}(p)
  + D_{G^0}^lambda_{mu nu alpha}(p) KhG_{rho sigma lambda}^{mu nu}(p) = 0.
The mixed kernel carries +p in this identity. Index raising and lowering uses \
eta; coefficient tensors are understood on the symmetric field slots.\
\>", "Text",ExpressionUUID->"08baac01-043c-438c-abdc-f48611b01839"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"indiceswh", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"m1", ",", "m2", ",", "m3"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permswh", " ", "=", " ", 
   RowBox[{"Permutations", "[", "indiceswh", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"protowh", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"p", ",", "p"}], "]"}], 
      RowBox[{"p", "[", "m1", "]"}], 
