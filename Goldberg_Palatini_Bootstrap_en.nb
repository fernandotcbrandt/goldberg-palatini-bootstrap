715a7a239fe7"],

Cell["\<\
Orbit: permute all index slots of the proto-tensors (products of eta and \
momentum with the required index count and momentum degree), then remove \
duplicates. This enumerates the candidate monomials; the kernel-symmetry \
orbits are averaged in the next step.\
\>", "Text",
 CellChangeTimes->{{3.9931168303320503`*^9, 
  3.9931168327707376`*^9}},ExpressionUUID->"9509d2f2-8e34-4af9-b21a-\
405d50b73dff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"indicesV", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "m1", ",", "m2", ",", "m3", ",", "m4", ",", "m5", ",", "m6", ",", "m7", 
     ",", "m8"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permsV", " ", "=", " ", 
   RowBox[{"Permutations", "[", "indicesV", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"protoV", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dt", "[", 
      RowBox[{"m1", ",", "m2"}], "]"}], 
     RowBox[{"dt", "[", 
      RowBox[{"m3", ",", "m4"}], "]"}], 
     RowBox[{"dt", "[", 
      RowBox[{"m5", ",", "m6"}], "]"}], 
     RowBox[{"dt", "[", 
      RowBox[{"m7", ",", "m8"}], "]"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.993116835725431*^9, 3.993116917015326*^9}, {
  3.993117477462863*^9, 3.99311747889575*^9}, {3.993117661785041*^9, 
  3.9931176915915813`*^9}, {3.993117800663457*^9, 3.993117855444088*^9}, {
  3.993118159239369*^9, 3.993118174419446*^9}, {3.9949317024367037`*^9, 
  3.994931703339669*^9}, {3.99493189111327*^9, 3.99493190519908*^9}, {
  3.9949319951722097`*^9, 3.994932018757674*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"ab4ba060-b30c-4be6-84d9-8be12dbaf680"],

Cell[BoxData[
 RowBox[{
  RowBox[{"orbitV", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"proto", "/.", 
         RowBox[{"Thread", "[", 
          RowBox[{"indicesV", " ", "->", " ", "perm"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"proto", ",", "protoV"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"perm", ",", "permsV"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9931169565308523`*^9, 3.993116963356805*^9}, {
   3.993117521495758*^9, 3.993117525394308*^9}, {3.993117682983285*^9, 
   3.993117702331469*^9}, {3.9931178506167393`*^9, 3.993117861450924*^9}, {
   3.993117912872353*^9, 3.9931179133521852`*^9}, {3.9949320230206337`*^9, 
   3.994932033861989*^9}, 3.995549270658732*^9},
 CellLabel->
  "In[113]:=",ExpressionUUID->"767cc304-76aa-45c2-bc50-3c83954c01ea"],

Cell["\<\
Symmetrization: average each monomial over the kernel's index-symmetry group. \
Distinct orbits give independent formal expressions; their tensor \
independence is checked below (Appendix C of the paper).\
\>", "Text",
 CellChangeTimes->{{3.9931173598484163`*^9, 
  3.993117363100174*^9}},ExpressionUUID->"ab9fc75f-4fc5-4759-b2c7-\
6156dae10039"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"symV", "[", "expr_", "]"}], ":=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"sym2", "[", 
     RowBox[{
      RowBox[{"sym2", "[", 
       RowBox[{
        RowBox[{"sym2", "[", 
         RowBox[{
          RowBox[{"sym2", "[", 
           RowBox[{"expr", ",", "m1", ",", "m2"}], "]"}], ",", "m4", ",", 
          "m5"}], "]"}], ",", "m7", ",", "m8"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"m3", ",", "m4", ",", "m5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m6", ",", "m7", ",", "m8"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"basisV", " ", "=", " ", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"Union", "[", 
     RowBox[{"symV", "/@", "orbitV"}], "]"}], ",", "0"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The number of basis elements is \>\"", ",", 
   RowBox[{"Length", "[", "basisV", "]"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
