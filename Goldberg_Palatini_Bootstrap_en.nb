Cell[CellGroupData[{

Cell["Constraints on the vertices:", "Subsection",
 CellChangeTimes->{{3.993708997043008*^9, 
  3.993709020019251*^9}},ExpressionUUID->"d94ba343-ea12-4c49-9be0-\
e055c393cb41"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wardH", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Rho]_", ",", "\[Sigma]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Contract", "[", 
    RowBox[{
     RowBox[{"2", "*", 
      RowBox[{"delh0p", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], "]"}], 
      RowBox[{"Khh", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]"}], 
       "]"}]}], "+", 
     RowBox[{
      RowBox[{"delG0p", "[", 
       RowBox[{"\[Lambda]", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], 
       "]"}], 
      RowBox[{"KhG", "[", 
       RowBox[{
       "\[Rho]", ",", "\[Sigma]", ",", "\[Lambda]", ",", "\[Mu]", ",", 
        "\[Nu]"}], "]"}]}]}], "]"}], "//", "Expand"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wardG", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Rho]_", ",", "\[Sigma]_", ",", "\[Tau]_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"Contract", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"delh0p", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], "]"}], 
      RowBox[{"KGh", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]", ",", "\[Tau]"}],
        "]"}]}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"delG0p", "[", 
       RowBox[{"\[Lambda]", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]"}], 
       "]"}], 
      RowBox[{"KGG", "[", 
