Cell["\<\
Symmetrization: average each monomial over the kernel's index-symmetry group. \
Distinct orbits give independent formal expressions; their tensor \
independence is checked below (Appendix C of the paper).\
\>", "Text",
 CellChangeTimes->{{3.9931173598484163`*^9, 
  3.993117363100174*^9}},ExpressionUUID->"c2d07160-8c2d-4149-a039-\
7128951ad37c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"symhG", "[", "expr_", "]"}], ":=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"expr", "+", 
       RowBox[{"swap", "[", 
        RowBox[{"expr", ",", "m1", ",", "m2"}], "]"}], "+", 
       RowBox[{"swap", "[", 
        RowBox[{"expr", ",", "m4", ",", "m5"}], "]"}], "+", 
       RowBox[{"swap", "[", 
        RowBox[{
         RowBox[{"swap", "[", 
          RowBox[{"expr", ",", "m1", ",", "m2"}], "]"}], ",", "m4", ",", 
         "m5"}], "]"}]}], ")"}], "/", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"basishG", " ", "=", " ", 
  RowBox[{"\[ImaginaryI]", "*", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"symhG", "/@", "orbithG"}], "]"}], ",", "0"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The number of basis elements is \>\"", ",", 
   RowBox[{"Length", "[", "basishG", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.993117372900117*^9, 3.993117436454687*^9}, {
