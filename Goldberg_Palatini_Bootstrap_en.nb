          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Rho]\[Tau]", "\[Sigma]"], "\[LongEqual]", 
          "-", 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox["\[Phi]", 
           RowBox[{",", "\[Lambda]"}], "\[Mu]\[Nu]"], "+", 
          FractionBox["1", "2"], 
          SubsuperscriptBox[
           StyleBox["M", "TI"], "\[Lambda]\[Sigma]", 
           "\[Mu]\[Nu]\[Rho]\[Tau]"], 
          RowBox[{"(", "\[Eta]", ")"}], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Rho]\[Tau]", "\[Sigma]"], "+", 
          FractionBox["1", "2"], 
          SubsuperscriptBox[
           StyleBox["M", "TI"], "\[Lambda]\[Sigma]", 
           "\[Mu]\[Nu]\[Rho]\[Tau]"], 
          RowBox[{"(", "\[Phi]", ")"}], 
          SubsuperscriptBox[
