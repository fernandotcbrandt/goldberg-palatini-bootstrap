Notebook[{

Cell[CellGroupData[{
Cell["Palatini-Goldberg Bootstrap for Gravity in Momentum Space", "Title",
 CellChangeTimes->{{3.994932452363154*^9, 
  3.994932500415036*^9}},ExpressionUUID->"f00586b6-d56d-49e4-a8a1-\
0959e976f4ff"],

Cell[TextData[{
 "This notebook reconstructs the Goldberg-Palatini action from the Noether \
identities (classical Ward identities) of prescribed gauge transformations in \
momentum space, using FeynCalc. It generates the kernel and projection bases, \
constructs the six identities, solves their coefficient constraints, and \
compares the first-order kernels with the literature.\n\nConventions: Lorentz \
indices and momenta are treated abstractly in Nd dimensions using FeynCalc. \
No explicit metric components are assigned. ",
 "Nd",
 " is used  here for dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["d", "TI"], TraditionalForm], "errors" -> {}, "input" -> "d", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "305a6d6a-d9c0-479b-bac0-a6714167cbff"],
 " because D is reserved in Mathematica. Index parentheses in the analytical \
formulas denote unnormalized symmetrization, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{"(", "\[Mu]\[Nu]", ")"}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["A", "TI"], "\[Mu]\[Nu]"], "+", 
         SubscriptBox[
          StyleBox["A", "TI"], "\[Nu]\[Mu]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "A_{(\\mu\\nu)} = A_{\\mu\\nu} + A_{\\nu\\mu}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "87bbbafa-ac09-4b9b-951b-b1ddc06177a8"],
 ". The basis construction uses normalized group averages. The Fourier \
convention is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", "\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["x", "TI"], " ", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["p", "TI"], "\[CenterDot]", 
            StyleBox["x", "TI"]}]], 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "f(p) = \\int d^{d}x\\,e^{i p\\cdot x}f(x)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fd3f7c05-a5d6-4c57-8413-5ca4c17a82a9"],
 ", with inverse measure ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        RowBox[{
          SuperscriptBox[
           StyleBox["d", "TI"], 
           StyleBox["d", "TI"]], 
          StyleBox["p", "TI"]}], 
        SuperscriptBox[
         RowBox[{"(", 
           RowBox[{"2", "\[Pi]"}], ")"}], 
         StyleBox["d", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{d^d p}{(2 \\pi)^d}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b6359f0-542f-4882-800e-6ac886f87875"],
 ", so a derivative on a field carrying momentum p gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         StyleBox["i", "TI"], 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-i p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d33d2f3-9392-4491-94b9-9246dc2f141b"],
 ". The coupling is set to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Kappa]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\kappa = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ff7c98e-c413-4d58-9d62-284c75ff693b"],
 "; the full metric density is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["h", "TI"], "\[Mu]\[Nu]"], "\[LongEqual]", 
         SuperscriptBox["\[Eta]", "\[Mu]\[Nu]"], "+", 
         SuperscriptBox["\[Phi]", "\[Mu]\[Nu]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "h^{\\mu\\nu} = \\eta^{\\mu\\nu} + \\phi^{\\mu\\nu}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4076518-b6b5-41e9-9c67-3475325d365c"],
 ".\n\nCode-to-paper notation: the ",
 StyleBox["h",
  FontSlant->"Italic"],
 " in names such as ",
 StyleBox["Khh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["KhG",
  FontSlant->"Italic"],
 " and ",
 StyleBox["delh0p",
  FontSlant->"Italic"],
 " denotes the metric-density perturbation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19b5fe9a-4493-4af7-89f2-f8ebaf21489a"],
 ", not the full density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["h", "TI"], "\[Mu]\[Nu]"], TraditionalForm], "errors" -> {}, 
     "input" -> "h^{\\mu\\nu}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79bdd2c2-043b-4c10-b899-e68a0c77cbc3"],
 ". ",
 StyleBox["Khh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["KhG",
  FontSlant->"Italic"],
 ", ",
 StyleBox["KGG",
  FontSlant->"Italic"],
 " and ",
 StyleBox["KhGG",
  FontSlant->"Italic"],
 " correspond to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["K", "TI"], "\[Phi]\[Phi]"], TraditionalForm], 
     "errors" -> {}, "input" -> "K^{\\phi \\phi}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d7d43f6-833f-4e57-a1cc-fa8b1757ff1d"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["K", "TI"], "\[Phi]"], TraditionalForm], "errors" -> {}, 
     "input" -> "K^{\\phi \\G}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68f98c94-d6be-49cf-9eae-b965f2fcdeeb"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["K", "TI"], 
        RowBox[{
          StyleBox["G", "TI"], 
          StyleBox["G", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "K^{GG}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "292b7c95-5029-4580-aaac-b1a265806d73"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["K", "TI"], 
        RowBox[{"\[Phi]", 
          StyleBox["G", "TI"], 
          StyleBox["G", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "K^{\\phi GG}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "48f307ac-583d-4192-bc18-5209880c8119"],
 " (likewise for Wh and WG, respectively, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["W", "TI"], "\[Phi]"], ", ", 
         SuperscriptBox[
          StyleBox["W", "TI"], 
          StyleBox["G", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "W^{\\phi},\\,W^{G}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6caff2f5-c24b-4932-b7be-6dc6e67ea748"],
 "). ",
 StyleBox["delh0p",
  FontSlant->"Italic"],
 " and ",
 StyleBox["delG0p",
  FontSlant->"Italic"],
 " represent ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        SuperscriptBox["\[Phi]", "0"]], TraditionalForm], "errors" -> {}, 
     "input" -> "D_{\\phi^0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bfde9356-101e-47f9-aff8-d4e71e65b0b5"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        SuperscriptBox[
         StyleBox["G", "TI"], "0"]], TraditionalForm], "errors" -> {}, 
     "input" -> "D_{G^0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc06244c-3860-498c-8020-a6abf5517fd6"],
 "; ",
 StyleBox["delh1pq",
  FontSlant->"Italic"],
 " and ",
 StyleBox["delG1pq",
  FontSlant->"Italic"],
 " represent the field-dependent maps ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        SuperscriptBox["\[Phi]", "1"]], TraditionalForm], "errors" -> {}, 
     "input" -> "D_{\\phi^1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "504301eb-350d-4aeb-aadc-db367b931072"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["D", "TI"], 
        SuperscriptBox[
         StyleBox["G", "TI"], "1"]], TraditionalForm], "errors" -> {}, 
     "input" -> "D_{G^1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a24a827d-9af6-4ec9-9ddd-2209258299c3"],
 ". The coefficient lists ",
 StyleBox["cfehh",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cfehG",
  FontSlant->"Italic"],
 ", ",
 StyleBox["cfeGG",
  FontSlant->"Italic"],
 " and ",
 StyleBox["cfehGG",
  FontSlant->"Italic"],
 " follow the displayed notebook basis order, which differs from the paper's \
order. ",
 StyleBox["basishG",
  FontSlant->"Italic"],
 " includes an explicit factor ",
 StyleBox["i",
  FontSlant->"Italic"],
 "; its coefficients are listed relative to that convention.\n\nRun the \
active input cells in order in a fresh kernel with FeynCalc installed. The \
optional Nd = 4 Gram diagnostic is commented out; keep Nd symbolic for the \
main calculation. The final sections check the first-order kernels and export \
them for the separate xAct comparison with CLM."
}], "Text",
 CellChangeTimes->{
  3.99883254570931*^9, 3.998832592529652*^9, {3.998832804222014*^9, 
   3.9988328218780537`*^9}, {3.998832862342875*^9, 3.99883288402417*^9}, 
   3.998832917726754*^9, {3.998833215570929*^9, 3.998833228415515*^9}, {
   3.998833373556919*^9, 3.998833421833888*^9}, {3.998833695241659*^9, 
   3.9988337796836977`*^9}, {3.9989272114739103`*^9, 3.998927265731936*^9}},
 CellTags->
  "NotebookOverview",ExpressionUUID->"19424312-1e2a-4c86-aabd-a9a791c2897c"],

