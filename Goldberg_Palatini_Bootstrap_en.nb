Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Nd", "=", "D"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "D", " ", "is", " ", "reserved", " ", "for", " ", "differentiation", " ",
       "in", " ", "Mathematica"}], ";", " ", 
     RowBox[{"use", " ", 
      RowBox[{"Nd", "."}]}]}], " ", "*)"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"dt", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"MetricTensor", "[", 
      RowBox[{"a", ",", "b", ",", 
       RowBox[{"Dimension", "->", "Nd"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fv", "[", 
      RowBox[{"q_", ",", "a_"}], "]"}], ":=", 
     RowBox[{"FourVector", "[", 
      RowBox[{"q", ",", "a", ",", 
       RowBox[{"Dimension", "->", "Nd"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Generic", " ", "four"}], "-", "vector"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "\[Mu]_", "]"}], ":=", 
     RowBox[{"fv", "[", 
      RowBox[{"p", ",", "\[Mu]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sp", "[", 
      RowBox[{"q_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"ScalarProduct", "[", 
      RowBox[{"q", ",", "r", ",", 
       RowBox[{"Dimension", "->", "Nd"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Scalar", " ", "product"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Iunit", "=", "I"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Imaginary", " ", 
     RowBox[{"unit", "?"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sym2", "[", 
      RowBox[{"expr_", ",", "x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"expr", "+", 
         RowBox[{"(", 
          RowBox[{"expr", "/.", "  ", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Thread", "[", 
               RowBox[{"x", "->", "y"}], "]"}], ",", 
              RowBox[{"Thread", "[", 
               RowBox[{"y", "->", "x"}], "]"}]}], "}"}], "]"}]}], ")"}]}], 
        ")"}], "/", "2"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Symmetrize", " ", "the", " ", "expression", " ", "over", " ", "the", " ",
      "index", " ", "pairs", " ", "x", " ", "and", " ", 
     RowBox[{"y", "."}]}], " ", "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"swap", "[", 
     RowBox[{"expr_", ",", "x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"expr", "/.", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{"x", "->", "y"}], "]"}], ",", 
        RowBox[{"Thread", "[", 
         RowBox[{"y", "->", "x"}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
