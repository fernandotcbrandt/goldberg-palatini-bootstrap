    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{
       RowBox[{"basiswh", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basiswh", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "//", "FullSimplify"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "basiswh", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"Length", "[", "basiswh", "]"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", "Gramwh", "]"}], "//", "Factor"}]}], "Input",
