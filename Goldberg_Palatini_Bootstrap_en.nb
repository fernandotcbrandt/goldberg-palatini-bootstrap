   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"W34", "[", 
     RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "]"}], "[", 
    RowBox[{
    "\[Lambda]1_", ",", "\[Mu]1_", ",", "\[Nu]1_", ",", "\[Lambda]2_", ",", 
