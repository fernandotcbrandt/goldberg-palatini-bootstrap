Cell["\<\
Symmetrization: average each monomial over the kernel's index-symmetry group. \
Distinct orbits give independent formal expressions; their tensor \
independence is checked below (Appendix C of the paper).\
\>", "Text",
 CellChangeTimes->{{3.9931173598484163`*^9, 
  3.993117363100174*^9}},ExpressionUUID->"7bda38a8-c783-470c-8b30-\
4829b055657e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"symGG", "[", "expr_", "]"}], ":=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"sym2", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"expr", "+", 
         RowBox[{"swap", "[", 
          RowBox[{"expr", ",", "m2", ",", "m3"}], "]"}], "+", 
         RowBox[{"swap", "[", 
          RowBox[{"expr", ",", "m5", ",", "m6"}], "]"}], "+", 
         RowBox[{"swap", "[", 
          RowBox[{
           RowBox[{"swap", "[", 
            RowBox[{"expr", ",", "m2", ",", "m3"}], "]"}], ",", "m5", ",", 
           "m6"}], "]"}]}], ")"}], "/", "4"}], ",", 
      RowBox[{"{", 
       RowBox[{"m1", ",", "m2", ",", "m3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m4", ",", "m5", ",", "m6"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"basisGG", " ", "=", " ", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"Union", "[", 
     RowBox[{"symGG", "/@", "orbitGG"}], "]"}], ",", "0"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The number of basis elements is \>\"", ",", 
   RowBox[{"Length", "[", "basisGG", "]"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.993117372900117*^9, 3.993117436454687*^9}, {
