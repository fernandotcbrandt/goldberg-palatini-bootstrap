Cell[TextData[{
 "Wh is the identity obtained upon takin the functional derivative of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Delta]", 
          RowBox[{"(", "0", ")"}]], 
         SubscriptBox[
          StyleBox["S", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\delta^(0) S_2 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d22c0477-48de-43fc-aff8-61e429598ef1"],
 " with respect to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[Phi]", "~"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\tilde{\\phi}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "217197c6-61d0-4512-8c57-632ae66dd405"],
 ".\nThe mixed kernel carries +p in this identity. Index raising and lowering \
uses eta; coefficient tensors are understood on the symmetric field slots."
}], "Text",
 CellChangeTimes->{
  3.998571779390605*^9, {3.998927695268963*^9, 3.9989276961516647`*^9}, {
