Cell[CellGroupData[{

Cell["0) FeynCalc Setup", "Section",
 CellChangeTimes->{{3.992955925163237*^9, 3.992955932006826*^9}, {
  3.9952883280476093`*^9, 
  3.995288328972186*^9}},ExpressionUUID->"a21d27d1-718c-4e9b-aece-\
996db0bfe1e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Nd", "=", "D"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "D", " ", "is", " ", "reserved", " ", "for", " ", "differentiation", " ",
       "in", " ", "Mathematica"}], ";", " ", 
     RowBox[{"use", " ", 
      RowBox[{"Nd", "."}]}]}], " ", "*)"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"dt", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"MetricTensor", "[", 
      RowBox[{"a", ",", "b", ",", 
       RowBox[{"Dimension", "->", "Nd"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fv", "[", 
      RowBox[{"q_", ",", "a_"}], "]"}], ":=", 
     RowBox[{"FourVector", "[", 
      RowBox[{"q", ",", "a", ",", 
       RowBox[{"Dimension", "->", "Nd"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Generic", " ", "four"}], "-", "vector"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "\[Mu]_", "]"}], ":=", 
     RowBox[{"fv", "[", 
      RowBox[{"p", ",", "\[Mu]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sp", "[", 
      RowBox[{"q_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"ScalarProduct", "[", 
      RowBox[{"q", ",", "r", ",", 
       RowBox[{"Dimension", "->", "Nd"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Scalar", " ", "product"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Iunit", "=", "I"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Imaginary", " ", 
     RowBox[{"unit", "?"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sym2", "[", 
      RowBox[{"expr_", ",", "x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"expr", "+", 
         RowBox[{"(", 
          RowBox[{"expr", "/.", "  ", 
           RowBox[{"Flatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Thread", "[", 
               RowBox[{"x", "->", "y"}], "]"}], ",", 
              RowBox[{"Thread", "[", 
               RowBox[{"y", "->", "x"}], "]"}]}], "}"}], "]"}]}], ")"}]}], 
        ")"}], "/", "2"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Symmetrize", " ", "the", " ", "expression", " ", "over", " ", "the", " ",
      "index", " ", "pairs", " ", "x", " ", "and", " ", 
     RowBox[{"y", "."}]}], " ", "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"swap", "[", 
     RowBox[{"expr_", ",", "x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"expr", "/.", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{"x", "->", "y"}], "]"}], ",", 
        RowBox[{"Thread", "[", 
         RowBox[{"y", "->", "x"}], "]"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.992955790316739*^9, 3.992955807086981*^9}, {
   3.9929558520840178`*^9, 3.992955892903542*^9}, {3.992955947034021*^9, 
   3.992956014826377*^9}, {3.992956049464834*^9, 3.992956068374228*^9}, {
   3.992956279746717*^9, 3.992956313489286*^9}, {3.992956395112845*^9, 
   3.992956414641518*^9}, {3.992956504593154*^9, 3.992956508463385*^9}, {
   3.993113955682076*^9, 3.993113962768627*^9}, 3.993114084718659*^9, {
   3.9931143088319473`*^9, 3.993114309499342*^9}, {3.993114452304035*^9, 
   3.993114567699045*^9}, 3.99311468605766*^9, {3.9931149901505747`*^9, 
   3.993115041592173*^9}, 3.9931151119744387`*^9, {3.993115321091317*^9, 
   3.993115417220621*^9}, {3.993115531719514*^9, 3.993115567514428*^9}, {
   3.9931160145776043`*^9, 3.993116034422966*^9}, {3.993116116675004*^9, 
   3.993116185655106*^9}, {3.9931162206445427`*^9, 3.9931162247040157`*^9}, {
   3.993116274425407*^9, 3.9931163361363487`*^9}, {3.993116373720859*^9, 
