   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"dt", "[", 
        RowBox[{"\[Lambda]", ",", "\[Mu]"}], "]"}], 
       RowBox[{"p", "[", "\[Nu]", "]"}]}], "+", 
      RowBox[{
       RowBox[{"dt", "[", 
        RowBox[{"\[Lambda]", ",", "\[Nu]"}], "]"}], 
       RowBox[{"p", "[", "\[Mu]", "]"}]}]}], ")"}], 
