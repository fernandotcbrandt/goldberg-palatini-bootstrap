Cell[CellGroupData[{

Cell["8) Cubic Noether Identities", "Section",
 CellChangeTimes->{{3.994933214947204*^9, 3.994933218471347*^9}, {
  3.998929534541067*^9, 
  3.9989295348562937`*^9}},ExpressionUUID->"68e54282-e28f-4ebf-b255-\
d6d222849ef7"],

Cell[TextData[{
 "Combining the identities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"{", 
          Cell[
           BoxData[
            FormBox[
             GridBox[{{
                Cell[
                 TextData[{" ", 
                   Cell[
                    BoxData[
                    RowBox[{
                    SuperscriptBox["\[Delta]", 
                    RowBox[{"(", "1", ")"}]], 
                    SubscriptBox[
                    StyleBox["S", "TI"], "2"], "+", 
                    SuperscriptBox["\[Delta]", 
                    RowBox[{"(", "0", ")"}]], 
                    SubscriptBox[
                    StyleBox["S", "TI"], "3"], "\[LongEqual]", "0"}]], 
                    "InlineFormula"], " "}]]}, {
                Cell[
                 TextData[{" ", 
                   Cell[
                    BoxData[
                    RowBox[{
                    SuperscriptBox["\[Delta]", 
                    RowBox[{"(", "1", ")"}]], 
                    SubscriptBox[
                    StyleBox["S", "TI"], "3"], "\[LongEqual]", "0"}]], 
                    "InlineFormula"], " "}]]}}], TraditionalForm]]]}], 
        TraditionalForm], "errors" -> {}, "input" -> 
      "\\begin{cases} \\delta^{(1)} S_{2} + \\delta^{(0)} S_{3} =0 \\\\  \
\\delta^{(1)} S_{3} = 0 \\end{cases}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " "}], TraditionalForm]],ExpressionUUID->
  "7beda380-12c0-48c3-820c-e6a600515fcf"],
 ", we obtain four new identities."
}], "Text",
 CellChangeTimes->{{3.994933230055551*^9, 3.99493327245611*^9}, {
   3.9949333053620157`*^9, 3.994933322456942*^9}, {3.994933376112337*^9, 
   3.994933376284876*^9}, {3.9949440514254017`*^9, 3.99494405337103*^9}, {
   3.99494725920944*^9, 3.994947279513451*^9}, 
   3.9955493623536873`*^9},ExpressionUUID->"946739ba-0faf-4dd1-8380-\
18cfe61ce660"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"W31", "[", 
      RowBox[{"p1_", ",", "p2_"}], "]"}], "[", 
     RowBox[{
     "\[Mu]1_", ",", "\[Nu]1_", ",", "\[Mu]2_", ",", "\[Nu]2_", ",", 
      "\[Rho]_"}], "]"}], ":=", 
    RowBox[{"Contract", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Khh", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "\[Alpha]", ",", "\[Beta]"}], 
          "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"p", "->", "p1"}], "}"}]}], ")"}], 
       RowBox[{
        RowBox[{"delh1pq", "[", 
         RowBox[{"p1", ",", 
          RowBox[{"p1", "+", "p2"}]}], "]"}], "[", 
        RowBox[{
        "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]2", ",", "\[Nu]2", ",", 
         "\[Rho]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Khh", "[", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "\[Alpha]", ",", "\[Beta]"}], 
          "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"p", "->", "p2"}], "}"}]}], ")"}], 
       RowBox[{
        RowBox[{"delh1pq", "[", 
         RowBox[{"p2", ",", 
          RowBox[{"p1", "+", "p2"}]}], "]"}], "[", 
        RowBox[{
        "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]1", ",", "\[Nu]1", ",", 
         "\[Rho]"}], "]"}]}]}], "]"}]}], " ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
