      RowBox[{"p", "[", "m3", "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"orbitwh", " ", "=", " ", 
  RowBox[{"DeleteDuplicates", "[", 
