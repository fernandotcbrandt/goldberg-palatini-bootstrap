Cell["\<\
Linear independence: form the Gram matrix by contracting all indices between \
pairs of basis elements. A nonzero determinant proves independence. After \
separating powers of p^2 where present, dimension-dependent degeneracies can \
be identified using the positive Euclidean contraction pairing at nonzero \
momentum. The resulting polynomial tensor relations also hold in Lorentzian \
signature. A singular Lorentzian Gram matrix at null momentum alone does not \
prove tensor dependence. For basishG, remove its explicit factor i when \
interpreting positivity; this phase does not affect independence.\
\>", "Text",
 CellChangeTimes->{{3.993119812289404*^9, 
  3.993119816336316*^9}},ExpressionUUID->"2c0bd5f8-a742-4fc8-8be2-\
88a13bb117fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GramhG", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{
       RowBox[{"basishG", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basishG", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "//", "FullSimplify"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "basishG", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"Length", "[", "basishG", "]"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", "GramhG", "]"}], "//", "Factor"}]}], "Input",
 CellChangeTimes->{{3.993118377709011*^9, 3.993118526693413*^9}, {
  3.993119818313586*^9, 3.993119833940524*^9}},
