Cell[CellGroupData[{

Cell["Discussion", "Subsubsection",
 CellChangeTimes->{{3.993119991916099*^9, 
  3.993120008456174*^9}},ExpressionUUID->"f6384c90-9347-464f-86e8-\
f04c7387797d"],

Cell["\<\
The dimension-dependent zeros of these Gram determinants at Nd = 1 and Nd = 2 \
reflect tensor identities that make the basis elements linearly dependent. \
This follows from the basis analysis itself; it is not inferred from the \
vanishing of the Einstein tensor in two dimensions.\
\>", "Text",
 CellChangeTimes->{
  3.993119987036086*^9, {3.998928215294484*^9, 
   3.9989282161271477`*^9}},ExpressionUUID->"892ad806-e92d-4a79-a0b7-\
f44da7734934"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

