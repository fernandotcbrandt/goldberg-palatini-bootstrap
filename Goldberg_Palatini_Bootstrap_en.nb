Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Khh", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "\[Rho]_", ",", "\[Sigma]_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"cfehh", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basishh", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "basishh", "]"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m1", "->", "\[Mu]"}], ",", 
      RowBox[{"m2", "->", "\[Nu]"}], ",", 
      RowBox[{"m3", "->", "\[Rho]"}], ",", 
      RowBox[{"m4", "->", "\[Sigma]"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"KhG", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Lambda]_", ",", "\[Rho]_", ",", 
     "\[Sigma]_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"cfehG", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basishG", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "basishG", "]"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m1", "->", "\[Mu]"}], ",", 
      RowBox[{"m2", "->", "\[Nu]"}], ",", 
      RowBox[{"m3", "->", "\[Lambda]"}], ",", 
      RowBox[{"m4", "->", "\[Rho]"}], ",", 
      RowBox[{"m5", "->", "\[Sigma]"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"KGG", "[", 
    RowBox[{
    "\[Lambda]_", ",", "\[Mu]_", ",", "\[Nu]_", ",", "\[Rho]_", ",", 
     "\[Sigma]_", ",", "\[Tau]_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"cfeGG", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basisGG", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "basisGG", "]"}]}], "}"}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m1", "->", "\[Lambda]"}], ",", 
      RowBox[{"m2", "->", "\[Mu]"}], ",", 
      RowBox[{"m3", "->", "\[Nu]"}], ",", 
      RowBox[{"m4", "->", "\[Rho]"}], ",", 
      RowBox[{"m5", "->", "\[Sigma]"}], ",", 
      RowBox[{"m6", "->", "\[Tau]"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KGh", "[", 
   RowBox[{
   "\[Mu]_", ",", "\[Nu]_", ",", "\[Lambda]_", ",", "\[Rho]_", ",", 
    "\[Sigma]_"}], "]"}], ":=", 
  RowBox[{"-", 
   RowBox[{"KhG", "[", 
    RowBox[{
    "\[Mu]", ",", "\[Nu]", ",", "\[Lambda]", ",", "\[Rho]", ",", "\[Sigma]"}],
     "]"}]}]}]}], "Input",
