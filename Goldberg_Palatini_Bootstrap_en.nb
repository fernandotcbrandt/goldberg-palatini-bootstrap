Cell["\<\
Orbit: permute all index slots of the proto-tensors (products of eta and \
momentum with the required index count and momentum degree), then remove \
duplicates. This enumerates the candidate monomials; the kernel-symmetry \
orbits are averaged in the next step.\
\>", "Text",
 CellChangeTimes->{{3.9929581450073767`*^9, 
  3.9929581491800013`*^9}},ExpressionUUID->"b4c910fd-a3d5-4480-abda-\
19675cd5fc5d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"indiceshh", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"m1", ",", "m2", ",", "m3", ",", "m4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permshh", " ", "=", " ", 
   RowBox[{"Permutations", "[", "indiceshh", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"protohh", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"p", ",", "p"}], "]"}], 
      RowBox[{"dt", "[", 
       RowBox[{"m1", ",", "m2"}], "]"}], 
      RowBox[{"dt", "[", 
       RowBox[{"m3", ",", "m4"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"p", "[", "m1", "]"}], 
      RowBox[{"p", "[", "m2", "]"}], 
      RowBox[{"dt", "[", 
       RowBox[{"m3", ",", "m4"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"orbithh", " ", "=", " ", 
  RowBox[{"DeleteDuplicates", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"proto", "/.", 
        RowBox[{"Thread", "[", 
         RowBox[{"indiceshh", " ", "->", " ", "perm"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"proto", ",", "protohh"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"perm", ",", "permshh"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.992958153389748*^9, 3.992958296825687*^9}, {
