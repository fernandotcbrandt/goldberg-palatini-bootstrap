Cell[CellGroupData[{

Cell["1) Linearized Gauge Transformations", "Section",
 CellChangeTimes->{{3.992956088336924*^9, 3.992956095323111*^9}, {
   3.992956630675166*^9, 3.992956631271222*^9}, 3.993672350559381*^9, {
   3.9937158822562017`*^9, 3.99371588424601*^9}, {3.99493255033003*^9, 
   3.994932550537342*^9}},ExpressionUUID->"0091552b-7ef7-498f-9f10-\
c40a4c39d262"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Delta]", 
          RowBox[{"(", "0", ")"}]], 
         SuperscriptBox[
          OverscriptBox["\[Phi]", "~"], "\[Mu]\[Nu]"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["D", "TI"], 
          SuperscriptBox["\[Phi]", "0"], "\[Mu]\[Nu]\[Alpha]"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], 
         SubscriptBox[
          OverscriptBox["\[Omega]", "~"], "\[Alpha]"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "; ", 
         SubsuperscriptBox[
          StyleBox["D", "TI"], 
          SuperscriptBox["\[Phi]", "0"], "\[Mu]\[Nu]\[Alpha]"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "\[LongEqual]", "-", 
         StyleBox["i", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox["\[Eta]", "\[Mu]\[Nu]"], 
             SuperscriptBox[
              StyleBox["p", "TI"], "\[Alpha]"], "-", 
             SuperscriptBox[
              StyleBox["p", "TI"], "\[Mu]"], 
             SuperscriptBox["\[Eta]", "\[Nu]\[Alpha]"], "-", 
             SuperscriptBox[
              StyleBox["p", "TI"], "\[Nu]"], 
             SuperscriptBox["\[Eta]", "\[Mu]\[Alpha]"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta^{(0)} \\tilde{\\phi}^{\\mu\\nu} (p) = \
D_{\\phi^{0}}^{\\mu\\nu\\alpha}(p)\\tilde{\\omega}_{\\alpha}(p);\\, \
D_{\\phi^{0}}^{\\mu\\nu\\alpha}(p) = \
-i(\\eta^{\\mu\\nu}p^{\\alpha}-p^{\\mu}\\eta^{\\nu\\alpha}-p^{\\nu}\\eta^{\\\
mu\\alpha})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2dcb718a-f50b-4d16-90ae-eef0fe0fb259"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Delta]", 
          RowBox[{"(", "0", ")"}]], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["G", "TI"], "~"], "\[Mu]\[Nu]", "\[Lambda]"], 
         "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            SuperscriptBox[
             StyleBox["G", "TI"], "0"], "\[Mu]\[Nu]\[Alpha]"}], "\[Lambda]"], 
         
         SuperscriptBox[
          OverscriptBox["\[Omega]", "~"], "\[Alpha]"], 
         RowBox[{"(", 
           StyleBox["p", "TI"], ")"}], "; ", 
         SubsuperscriptBox[
          StyleBox["D", "TI"], 
          SuperscriptBox[
           StyleBox["G", "TI"], "0"], "\[Lambda]\[Mu]\[Nu]\[Alpha]"], 
         "\[LongEqual]", 
         FractionBox["1", "2"], 
         SuperscriptBox[
          StyleBox["p", "TI"], "\[Alpha]"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["p", "TI"], "\[Mu]"], 
             SuperscriptBox["\[Eta]", "\[Lambda]\[Nu]"], "+", 
             SuperscriptBox[
              StyleBox["p", "TI"], "\[Nu]"], 
             SuperscriptBox["\[Eta]", "\[Lambda]\[Mu]"]}], ")"}], "-", 
         SuperscriptBox[
          StyleBox["p", "TI"], "\[Mu]"], 
         SuperscriptBox[
          StyleBox["p", "TI"], "\[Nu]"], 
         SuperscriptBox["\[Eta]", "\[Alpha]\[Lambda]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta^{(0)}\\tilde{G}^{\\lambda}_{\\mu\\nu}=D^{\\lambda}_{G^{0}\\mu\\\
nu\\alpha}\\tilde{\\omega}^{\\alpha}(p);\\,  \
D^{\\lambda\\mu\\nu\\alpha}_{G^{0}}=\\frac{1}{2}p^{\\alpha}(p^{\\mu}\\eta^{\\\
lambda\\nu}+p^{\\nu}\\eta^{\\lambda\\mu})-p^{\\mu}p^{\\nu}\\eta^{\\alpha\\\
lambda}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed9930f1-4f1f-418e-b0ec-0dc985745abe"]
