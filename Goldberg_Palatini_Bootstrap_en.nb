Cell[CellGroupData[{

Cell["10) Final Kernels and Comparisons", "Section",
 CellChangeTimes->{{3.995703529846883*^9, 3.995703536596262*^9}, {
  3.9989313607021637`*^9, 
  3.998931360948783*^9}},ExpressionUUID->"04e6c501-bdcd-4bc6-8017-\
559464564d61"],

Cell[TextData[{
 "From F. T. Brandt and D. G. C. McKeon, Radiative corrections and the \
Palatini action, arXiv:1601.04944, Eqs. (3.5)-(3.6), we have:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubscriptBox[
           StyleBox["L", "TI"], 
           RowBox[{"1", 
             StyleBox["E", "TI"], 
             StyleBox["H", "TI"]}]], "\[LongEqual]", "-", 
          SubsuperscriptBox[
           StyleBox["G", "TI"], "\[Mu]\[Nu]", "\[Lambda]"], 
          SubsuperscriptBox[
           StyleBox["h", "TI"], 
           RowBox[{",", "\[Lambda]"}], "\[Mu]\[Nu]"], "+", 
