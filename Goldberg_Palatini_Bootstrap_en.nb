     RowBox[{"-", "ahG"}]}], ",", 
    RowBox[{"aGG", "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Nd", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"ahG", "+", "cGG"}], ")"}]}], ")"}]}]}], ",", 
    RowBox[{"bGG", "\[Rule]", 
     RowBox[{
      FractionBox["1", "2"], " ", "ahG", " ", 
      RowBox[{"(", 
       RowBox[{"Nd", "-", "1"}], ")"}]}]}], ",", 
    RowBox[{"dGG", "\[Rule]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"ahG", "-", 
        RowBox[{"ahG", " ", "Nd"}]}], ")"}]}]}], ",", 
    RowBox[{"eGG", "\[Rule]", "ahG"}]}], "}"}], TraditionalForm]], "Output",
