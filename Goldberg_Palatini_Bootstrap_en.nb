Cell["\<\
Linear independence: form the Gram matrix by contracting all indices between \
pairs of basis elements. A nonzero determinant proves independence. \
\>", "Text",
 CellChangeTimes->{{3.993119812289404*^9, 3.993119816336316*^9}, 
   3.998927104077052*^9},ExpressionUUID->"932ba749-5270-4bcf-be86-\
57b3e1dc0899"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GramGG", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{
       RowBox[{"basisGG", "[", 
        RowBox[{"[", "i", "]"}], "]"}], 
       RowBox[{"basisGG", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "//", "FullSimplify"}], ",", 
    
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "basisGG", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"Length", "[", "basisGG", "]"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", "GramGG", "]"}], "//", "Factor"}]}], "Input",
 CellChangeTimes->{{3.993118377709011*^9, 3.993118526693413*^9}, {
